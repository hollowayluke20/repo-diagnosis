# --- caches and build noise ---
.ruff_cache/
.pytest_cache/
__pycache__/
*.pyc
.venv/

# --- the experiment's answer material ---
# Keeping these out is the point of the whole setup: anyone (or anything)
# reading this repo must not be able to see the answers before the test runs.
BUILD-TASK.md
keys/
subject-staging/
# Throwaway probes written to confirm specific bugs by running them. They are
# our own code, but each one names a defect and its exact trigger, so they leak
# answers as surely as keys/ does. Say the word and I will track them.
repro_check.py
verify_findings.py
v4_check.py

# --- downloaded or generated, not written here ---
# BugsInPy: cloned bug dataset, ~9MB / 2,400 files, upstream project.
BugsInPy/
# instances/: built test repos. ~121MB EACH (each carries its own Python
# installation) - about 3.4GB across 28. Fully reproducible from
# build_instances.py, so there is nothing to preserve.
instances/
# src/: 1,517 files of other people's project source (black, cookiecutter,
# luigi, sanic, thefuck), pulled in as a side effect of installing instances.
src/

# --- scoring output derived from the answer keys ---
# verdicts.json records, per finding, whether it named the file the bug is in.
# That points straight at the answer, so it stays out.
# reports/scores.md is now aggregate numbers plus a yes/no per instance - it is
# the result, not the answer - so it IS tracked: SCORING.md requires the numbers
# to live in this repo rather than in a sheet somewhere else.
reports/verdicts.json
reports/needs_judgement.json

# working copies made by the fixer - each carries a full Python install, and
# they are all reproducible from fix_bug.py
fixes/
_fix_schema.json

# Disposable current-Python copies made by check_still_runs.py.
portability_scratch/
# Per-instance portability errors can reveal the catalogue test names.
reports/portability.md
reports/portability_detail.json

# --- mined material: cloned repos and verbatim diffs, both excluded ---
# mining-cache/ is large; raw-parts/ holds other projects source code verbatim,
# and "take the idea, not the code" is not a policy if the code is committed.
mining-cache/
raw-parts/

# labelling scratch dir
_label_scratch/
_label_schema.json
