+        return {"ran": False, "failed": None, "returncode": None,
+                "command": cmd, "declared_command": declared,
+                "error": "test run timed out", "output": ""}
+    except OSError as e:
+        return {"ran": False, "failed": None, "returncode": None,
+                "command": cmd, "declared_command": declared,
+                "error": f"{type(e).__name__}: {e}", "output": ""}
