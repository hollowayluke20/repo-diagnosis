+
+def write_reports(results):
+    REPORTS.mkdir(exist_ok=True)
+    lines = ["# Portability", "", "| Instance | Verdict | OLD failed | NEW failed | Evidence |",
+             "| --- | --- | ---: | ---: | --- |"]
+    for item in results:
+        def number(run):
