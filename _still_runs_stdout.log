+            results.append(item)
+            print(f"    {item['verdict']} (old failed: {item['old']['failed']}, "
+                  f"new failed: {item['new']['failed']})", flush=True)
+    write_reports(results)
+    print("Report: reports/portability.md")
+
+
+if __name__ == "__main__":
+    main()

