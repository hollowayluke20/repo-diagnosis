 191:     def start(self, response):
 192:         """
 193:         Initiate and return a stream for `response` body  with progress
 194:         callback attached. Can be called only once.
 195: 
 196:         :param response: Initiated response object with headers already fetched
 197:         :type response: requests.models.Response
 198: 
 199:         :return: RawStream, output_file
 200: 
 201:         """
 202:         assert not self.status.time_started
 203: 
 204:         try:
 205:             total_size = int(response.headers['Content-Length'])
 206:         except (KeyError, ValueError, TypeError):
 207:             total_size = None
 208: 
 209:         if self._output_file:
 210:             if self._resume and response.status_code == PARTIAL_CONTENT:
 211:                 total_size = parse_content_range(
 212:                     response.headers.get('Content-Range'),
 213:                     self._resumed_from
 214:                 )
 215: 
 216:             else:
 217:                 self._resumed_from = 0
 218:                 try:
 219:                     self._output_file.seek(0)
 220:                     self._output_file.truncate()
 221:                 except IOError:
 222:                     pass  # stdout
 223:         else:
 224:             # TODO: Should the filename be taken from response.history[0].url?
 225:             # Output file not specified. Pick a name that doesn't exist yet.
 226:             filename = None
 227:             if 'Content-Disposition' in response.headers:
 228:                 filename = filename_from_content_disposition(
 229:                     response.headers['Content-Disposition'])
 230:             if not filename:
 231:                 filename = filename_from_url(
 232:                     url=response.url,
 233:                     content_type=response.headers.get('Content-Type'),
 234:                 )
 235:             self._output_file = open(get_unique_filename(filename), mode='a+b')
 236: 
 237:         self.status.started(
 238:             resumed_from=self._resumed_from,
 239:             total_size=total_size
 240:         )
 241: 
 242:         stream = RawStream(
 243:             msg=HTTPResponse(response),
 244:             with_headers=False,
 245:             with_body=True,
 246:             on_body_chunk_downloaded=self.chunk_downloaded,
 247:             chunk_size=1024 * 8
 248:         )
 249: 
 250:         self._progress_reporter.output.write(
 251:             'Downloading %sto "%s"\n' % (
 252:                 (humanize_bytes(total_size) + ' '
 253:                  if total_size is not None
 254:                  else ''),
 255:                 self._output_file.name
 256:             )
 257:         )
 258:         self._progress_reporter.start()
 259: 
 260:         return stream, self._output_file
 261: 
 262:     def finish(self):
 263:         assert not self.finished
 264:         self.finished = True
 265:         self.status.finished()
 266: 
 267:     def failed(self):
 268:         self._progress_reporter.stop()
 269: 
 270:     @property
 271:     def interrupted(self):
 272:         return (
 273:             self.finished
 274:             and self.status.total_size
 275:             and self.status.total_size != self.status.downloaded
 276:         )
 277: 
 278:     def chunk_downloaded(self, chunk):
 279:         """
 280:         A download progress callback.
 281: 
 282:         :param chunk: A chunk of response body data that has just
 283:                       been downloaded and written to the output.
 284:         :type chunk: bytes
 285: 
 286:         """
 287:         self.status.chunk_downloaded(len(chunk))
