 290: class Status(object):
 291:     """Holds details about the downland status."""
 292: 
 293:     def __init__(self):
 294:         self.downloaded = 0
 295:         self.total_size = None
 296:         self.resumed_from = 0
 297:         self.time_started = None
 298:         self.time_finished = None
 299: 
 300:     def started(self, resumed_from=0, total_size=None):
 301:         assert self.time_started is None
 302:         if total_size is not None:
 303:             self.total_size = total_size
 304:         self.downloaded = self.resumed_from = resumed_from
 305:         self.time_started = time()
 306: 
 307:     def chunk_downloaded(self, size):
 308:         assert self.time_finished is None
 309:         self.downloaded += size
 310: 
 311:     @property
 312:     def has_finished(self):
 313:         return self.time_finished is not None
 314: 
 315:     def finished(self):
 316:         assert self.time_started is not None
 317:         assert self.time_finished is None
 318:         self.time_finished = time()
 319: 
 320: 
 321: class ProgressReporterThread(threading.Thread):
 322:     """
 323:     Reports download progress based on its status.
 324: 
 325:     Uses threading to periodically update the status (speed, ETA, etc.).
 326: 
 327:     """
 328:     def __init__(self, status, output, tick=.1, update_interval=1):
 329:         """
 330: 
 331:         :type status: Status
 332:         :type output: file
 333:         """
 334:         super(ProgressReporterThread, self).__init__()
 335:         self.status = status
 336:         self.output = output
 337:         self._tick = tick
 338:         self._update_interval = update_interval
 339:         self._spinner_pos = 0
 340:         self._status_line = ''
 341:         self._prev_bytes = 0
 342:         self._prev_time = time()
 343:         self._should_stop = threading.Event()
 344: 
 345:     def stop(self):
 346:         """Stop reporting on next tick."""
 347:         self._should_stop.set()
 348: 
 349:     def run(self):
 350:         while not self._should_stop.is_set():
 351:             if self.status.has_finished:
 352:                 self.sum_up()
 353:                 break
 354: 
 355:             self.report_speed()
 356:             sleep(self._tick)
 357: 
 358:     def report_speed(self):
 359: 
 360:         now = time()
 361: 
 362:         if now - self._prev_time >= self._update_interval:
 363:             downloaded = self.status.downloaded
 364:             try:
 365:                 speed = ((downloaded - self._prev_bytes)
 366:                          / (now - self._prev_time))
 367:             except ZeroDivisionError:
 368:                 speed = 0
 369: 
 370:             if not self.status.total_size:
 371:                 self._status_line = PROGRESS_NO_CONTENT_LENGTH.format(
 372:                     downloaded=humanize_bytes(downloaded),
 373:                     speed=humanize_bytes(speed),
 374:                 )
 375:             else:
 376:                 try:
 377:                     percentage = downloaded / self.status.total_size * 100
 378:                 except ZeroDivisionError:
 379:                     percentage = 0
 380: 
 381:                 if not speed:
 382:                     eta = '-:--:--'
 383:                 else:
 384:                     s = int((self.status.total_size - downloaded) / speed)
 385:                     h, s = divmod(s, 60 * 60)
 386:                     m, s = divmod(s, 60)
 387:                     eta = '{0}:{1:0>2}:{2:0>2}'.format(h, m, s)
 388: 
 389:                 self._status_line = PROGRESS.format(
 390:                     percentage=percentage,
 391:                     downloaded=humanize_bytes(downloaded),
 392:                     speed=humanize_bytes(speed),
 393:                     eta=eta,
 394:                 )
 395: 
 396:             self._prev_time = now
 397:             self._prev_bytes = downloaded
 398: 
 399:         self.output.write(
 400:             CLEAR_LINE
 401:             + ' '
 402:             + SPINNER[self._spinner_pos]
 403:             + ' '
 404:             + self._status_line
 405:         )
 406:         self.output.flush()
 407: 
 408:         self._spinner_pos = (self._spinner_pos + 1
 409:                              if self._spinner_pos + 1 != len(SPINNER)
 410:                              else 0)
 411: 
 412:     def sum_up(self):
 413:         actually_downloaded = (self.status.downloaded
 414:                                - self.status.resumed_from)
 415:         time_taken = self.status.time_finished - self.status.time_started
 416: 
 417:         self.output.write(CLEAR_LINE)
 418: 
 419:         try:
 420:             speed = actually_downloaded / time_taken
 421:         except ZeroDivisionError:
 422:             # Either time is 0 (not all systems provide `time.time`
 423:             # with a better precision than 1 second), and/or nothing
 424:             # has been downloaded.
 425:             speed = actually_downloaded
 426: 
 427:         self.output.write(SUMMARY.format(
 428:             downloaded=humanize_bytes(actually_downloaded),
 429:             total=(self.status.total_size
 430:                    and humanize_bytes(self.status.total_size)),
 431:             speed=humanize_bytes(speed),
 432:             time=time_taken,
 433:         ))
 434:         self.output.flush()
   1: """Persistent, JSON-serialized sessions.
