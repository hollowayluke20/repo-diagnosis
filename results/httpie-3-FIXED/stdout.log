  77: class Session(BaseConfigDict):
  78:     helpurl = 'https://github.com/jkbrzt/httpie#sessions'
  79:     about = 'HTTPie session file'
  80: 
  81:     def __init__(self, path, *args, **kwargs):
  82:         super(Session, self).__init__(*args, **kwargs)
  83:         self._path = path
  84:         self['headers'] = {}
  85:         self['cookies'] = {}
  86:         self['auth'] = {
  87:             'type': None,
  88:             'username': None,
  89:             'password': None
  90:         }
  91: 
  92:     def _get_path(self):
  93:         return self._path
  94: 
  95:     def update_headers(self, request_headers):
  96:         """
  97:         Update the session headers with the request ones while ignoring
  98:         certain name prefixes.
  99: 
 100:         :type request_headers: dict
 101: 
 102:         """
 103:         for name, value in request_headers.items():
 104: 
 105:             if value is None:
 106:                 continue  # Ignore explicitely unset headers
 107: 
 108:             value = value.decode('utf8')
 109:             if name == 'User-Agent' and value.startswith('HTTPie/'):
 110:                 continue
 111: 
 112:             for prefix in SESSION_IGNORED_HEADER_PREFIXES:
 113:                 if name.lower().startswith(prefix.lower()):
 114:                     break
 115:             else:
 116:                 self['headers'][name] = value
 117: 
 118:     @property
 119:     def headers(self):
 120:         return self['headers']
 121: 
 122:     @property
 123:     def cookies(self):
 124:         jar = RequestsCookieJar()
 125:         for name, cookie_dict in self['cookies'].items():
 126:             jar.set_cookie(create_cookie(
 127:                 name, cookie_dict.pop('value'), **cookie_dict))
 128:         jar.clear_expired_cookies()
 129:         return jar
 130: 
 131:     @cookies.setter
 132:     def cookies(self, jar):
 133:         """
 134:         :type jar: CookieJar
 135:         """
 136:         # http://docs.python.org/2/library/cookielib.html#cookie-objects
 137:         stored_attrs = ['value', 'path', 'secure', 'expires']
 138:         self['cookies'] = {}
 139:         for cookie in jar:
 140:             self['cookies'][cookie.name] = dict(
 141:                 (attname, getattr(cookie, attname))
 142:                 for attname in stored_attrs
 143:             )
 144: 
 145:     @property
 146:     def auth(self):
 147:         auth = self.get('auth', None)
 148:         if not auth or not auth['type']:
 149:             return
 150:         auth_plugin = plugin_manager.get_auth_plugin(auth['type'])()
 151:         return auth_plugin.get_auth(auth['username'], auth['password'])
 152: 
 153:     @auth.setter
 154:     def auth(self, auth):
 155:         assert set(['type', 'username', 'password']) == set(auth.keys())
 156:         self['auth'] = auth
