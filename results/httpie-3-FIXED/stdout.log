   3: """
   4: import re
   5: import os
   6: 
   7: from requests.cookies import RequestsCookieJar, create_cookie
   8: 
   9: from httpie.compat import urlsplit
  10: from httpie.config import BaseConfigDict, DEFAULT_CONFIG_DIR
  11: from httpie.plugins import plugin_manager
  12: 
  13: 
  14: SESSIONS_DIR_NAME = 'sessions'
  15: DEFAULT_SESSIONS_DIR = os.path.join(DEFAULT_CONFIG_DIR, SESSIONS_DIR_NAME)
  16: VALID_SESSION_NAME_PATTERN = re.compile('^[a-zA-Z0-9_.-]+$')
  17: # Request headers starting with these prefixes won't be stored in sessions.
  18: # They are specific to each request.
  19: # http://en.wikipedia.org/wiki/List_of_HTTP_header_fields#Requests
  20: SESSION_IGNORED_HEADER_PREFIXES = ['Content-', 'If-']
  21: 
  22: 
  23: def get_response(requests_session, session_name,
  24:                  config_dir, args, read_only=False):
  25:     """Like `client.get_response`, but applies permanent
  26:     aspects of the session to the request.
  27: 
  28:     """
  29:     from .client import get_requests_kwargs, dump_request
  30:     if os.path.sep in session_name:
  31:         path = os.path.expanduser(session_name)
  32:     else:
  33:         hostname = (args.headers.get('Host', None)
  34:                     or urlsplit(args.url).netloc.split('@')[-1])
  35:         if not hostname:
  36:             # HACK/FIXME: httpie-unixsocket's URLs have no hostname.
  37:             hostname = 'localhost'
  38: 
  39:         # host:port => host_port
  40:         hostname = hostname.replace(':', '_')
  41:         path = os.path.join(config_dir,
  42:                             SESSIONS_DIR_NAME,
  43:                             hostname,
  44:                             session_name + '.json')
  45: 
  46:     session = Session(path)
  47:     session.load()
  48: 
  49:     kwargs = get_requests_kwargs(args, base_headers=session.headers)
  50:     if args.debug:
  51:         dump_request(kwargs)
  52:     session.update_headers(kwargs['headers'])
  53: 
  54:     if args.auth:
  55:         session.auth = {
  56:             'type': args.auth_type,
  57:             'username': args.auth.key,
  58:             'password': args.auth.value,
  59:         }
  60:     elif session.auth:
  61:         kwargs['auth'] = session.auth
  62: 
  63:     requests_session.cookies = session.cookies
  64: 
  65:     try:
  66:         response = requests_session.request(**kwargs)
  67:     except Exception:
  68:         raise
  69:     else:
  70:         # Existing sessions with `read_only=True` don't get updated.
  71:         if session.is_new() or not read_only:
  72:             session.cookies = requests_session.cookies
  73:             session.save()
  74:         return response
  75: 
