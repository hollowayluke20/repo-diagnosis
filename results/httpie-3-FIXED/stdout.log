 173:     def pre_request(self, request_headers):
 174:         """Called just before the HTTP request is sent.
 175: 
 176:         Might alter `request_headers`.
 177: 
 178:         :type request_headers: dict
 179: 
 180:         """
 181:         # Disable content encoding so that we can resume, etc.
 182:         request_headers['Accept-Encoding'] = None
 183:         if self._resume:
 184:             bytes_have = os.path.getsize(self._output_file.name)
 185:             if bytes_have:
 186:                 # Set ``Range`` header to resume the download
 187:                 # TODO: Use "If-Range: mtime" to make sure it's fresh?
 188:                 request_headers['Range'] = 'bytes=%d-' % bytes_have
 189:                 self._resumed_from = bytes_have
