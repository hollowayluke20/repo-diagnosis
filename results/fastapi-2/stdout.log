{"findings":[{"file":"fastapi/encoders.py","line":48,"what_goes_wrong":"`jsonable_encoder()` converts a nested `include` mapping to a plain set and consequently serializes nested fields that the caller selected out.","trigger":"Encode `{'payload': {'keep': 1, 'leak': 2}}` with `include={'payload': {'keep'}}`.","expected":"Only `{'payload': {'keep': 1}}` should be returned; instead the nested `leak` field is retained.","actual":"`{'payload': {'keep': 1, 'leak': 2}}` is returned.","confidence":"high","verified_by_running":true,"reproduction":"from fastapi.encoders import jsonable_encoder\n\nencoded = jsonable_encoder(\n    {'payload': {'keep': 1, 'leak': 2}},\n    include={'payload': {'keep'}},\n)\nassert encoded == {'payload': {'keep': 1}}"},{"file":"fastapi/security/http.py","line":146,"what_goes_wrong":"`HTTPDigest(auto_error=False)` still raises for a non-Digest Authorization scheme instead of indicating that this optional security dependency did not authenticate the request.","trigger":"Call `HTTPDigest(auto_error=False)` with a request containing `Authorization: Basic Zm9vOmJhcg==`.","expected":"The optional dependency should return `None`, as the other optional HTTP security schemes do for a mismatched scheme; it raises `HTTPException` instead.","actual":"An `HTTPException` with status 403 is raised.","confidence":"high","verified_by_running":true,"reproduction":"import asyncio\nfrom fastapi.security import HTTPDigest\nfrom starlette.requests import Request\n\nrequest = Request(\n    {'type': 'http', 'headers': [(b'authorization', b'Basic Zm9vOmJhcg==')]}\n)\ncredentials = asyncio.run(HTTPDigest(auto_error=False)(request))\nassert credentials is None"},{"file":"fastapi/openapi/utils.py","line":184,"what_goes_wrong":"OpenAPI generation deduplicates parameters only by name, so parameters with the same name in different valid locations overwrite each other.","trigger":"Declare one endpoint with `Query(..., alias='token')` and `Header(..., alias='token')`.","expected":"The schema should list both the query and header `token` parameters; it retains only one.","actual":"One of the two valid parameters is missing from the generated OpenAPI operation.","confidence":"high","verified_by_running":true,"reproduction":"from fastapi import FastAPI, Header, Query\n\napp = FastAPI()\n\n@app.get('/items')\ndef get_items(\n    query_token: str = Query(..., alias='token'),\n    header_token: str = Header(..., alias='token'),\n):\n    return {'query': query_token, 'header': header_token}\n\nparameters = app.openapi()['paths']['/items']['get']['parameters']\nassert {(p['name'], p['in']) for p in parameters} == {\n    ('token', 'query'),\n    ('token', 'header'),\n}"},{"file":"fastapi/applications.py","line":205,"what_goes_wrong":"`FastAPI.api_route()` does not accept or forward `callbacks`, even though the underlying router and FastAPI's verb-specific decorators support that option.","trigger":"Register a route using `app.api_route('/items', methods=['GET'], callbacks=[])`.","expected":"The route decorator should be returned and allow callback routes to be registered; construction raises before registration.","actual":"`TypeError: api_route() got an unexpected keyword argument 'callbacks'`.","confidence":"high","verified_by_running":true,"reproduction":"from fastapi import FastAPI\n\napp = FastAPI()\napp.api_route('/items', methods=['GET'], callbacks=[])(lambda: {'ok': True})"}],"what_examined":"Reviewed the FastAPI package’s routing, dependency/security, encoding, and OpenAPI-generation paths; used Ruff only as a lead; ran 437 non-tutorial tests successfully (the full suite’s tutorial collection needs its separate import path); and executed each reproduction above against the supplied Python installation."}
