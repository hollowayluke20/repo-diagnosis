{"findings":[{"file":"cookiecutter/generate.py","line":185,"what_goes_wrong":"Generating a text template with mixed LF and CRLF line endings raises TypeError instead of producing the file.","trigger":"A non-binary template file whose buffered read observes both `\\n` and `\\r\\n`, such as bytes `b'first\\nsecond\\r\\n'`.","expected":"The rendered file should be written; actual: `open()` receives a tuple of newline styles and raises `TypeError`.","actual":"`TypeError: open() argument 'newline' must be str or None, not tuple`","confidence":"high","verified_by_running":true,"reproduction":"import os\nimport tempfile\nfrom pathlib import Path\nfrom jinja2 import FileSystemLoader\nfrom cookiecutter.environment import StrictEnvironment\nfrom cookiecutter.generate import generate_file\n\nroot = Path(tempfile.mkdtemp())\n(root / 'project').mkdir()\n(root / 'template.txt').write_bytes(b'first\\nsecond\\r\\n')\nos.chdir(root)\nenv = StrictEnvironment(context={'cookiecutter': {}})\nenv.loader = FileSystemLoader('.')\ngenerate_file(str(root / 'project'), 'template.txt', {'cookiecutter': {}}, env)\n"},{"file":"cookiecutter/vcs.py","line":32,"what_goes_wrong":"An explicitly prefixed Git or Mercurial URL containing a valid `+` in its path is not stripped of its VCS prefix.","trigger":"`identify_repo('git+https://example.invalid/team/a+b.git')`.","expected":"Expected `('git', 'https://example.invalid/team/a+b.git')`; actual: `('git', 'git+https://example.invalid/team/a+b.git')`, which is then passed unchanged to the VCS client.","actual":"The prefix parser splits every plus sign rather than only the leading separator.","confidence":"high","verified_by_running":true,"reproduction":"from cookiecutter.vcs import identify_repo\n\nactual = identify_repo('git+https://example.invalid/team/a+b.git')\nassert actual == ('git', 'https://example.invalid/team/a+b.git'), actual\n"},{"file":"cookiecutter/cli.py","line":26,"what_goes_wrong":"The version banner truncates Python 3.10 and later minor