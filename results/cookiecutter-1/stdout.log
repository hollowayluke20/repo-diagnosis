{"findings":[{"file":"cookiecutter/generate.py","line":331,"what_goes_wrong":"`overwrite_if_exists=True` still crashes when a `_copy_without_render` directory already exists because `copytree` is called without permitting an existing destination.","trigger":"Generate a template containing `_copy_without_render: [\"assets\"]` twice into the same output directory; use `overwrite_if_exists=True` on the second generation.","expected":"The second generation should overwrite the copied directory's contents, as requested by `overwrite_if_exists`.","actual":"It raises `FileExistsError` for the existing `assets` directory.","confidence":"high","verified_by_running":true,"reproduction":"import json\nimport tempfile\nfrom pathlib import Path\nfrom cookiecutter.generate import generate_files\n\nwith tempfile.TemporaryDirectory() as temp:\n    base = Path(temp)\n    repo = base / \"repo\"\n    template = repo / \"{{cookiecutter.name}}\"\n    assets = template / \"assets\"\n    assets.mkdir(parents=True)\n    (repo / \"cookiecutter.json\").write_text(json.dumps({\"name\": \"project\", \"_copy_without_render\": [\"assets\"]}))\n    (assets / \"literal.txt\").write_text(\"{{cookiecutter.name}}\")\n    context = {\"cookiecutter\": {\"name\": \"project\", \"_copy_without_render\": [\"assets\"]}}\n    output = base / \"output\"\n    generate_files(str(repo), context, output_dir=str(output))\n    generate_files(str(repo), context, output_dir=str(output), overwrite_if_exists=True)\n    assert (output / \"project\" / \"assets\" / \"literal.txt\").exists()"},{"file":"cookiecutter/generate.py","line":185,"what_goes_wrong":"A text template with mixed LF and CRLF line endings crashes because `TextIOWrapper.newlines` is a tuple, which is not accepted as the `newline` argument to `open`.","trigger":"Generate a UTF-8 text template whose content is `b'one\\r\\ntwo\\n'`.","expected":"The text template should render into the output project.","actual":"It raises `TypeError: open() argument 'newline' must be str or None, not tuple`.","confidence":"high","verified_by_running":true,"reproduction":"import os\nimport tempfile\nfrom pathlib import Path\nfrom jinja2 import FileSystemLoader\nfrom cookiecutter.environment import StrictEnvironment\nfrom cookiecutter.generate import generate_file\n\nwith tempfile.TemporaryDirectory() as temp:\n    root = Path(temp)\n    (root / \"mixed.txt\").write_bytes(b\"one\\r\\ntwo\\n\")\n    output = root / \"output\"\n    output.mkdir()\n    previous = os.getcwd()\n    os.chdir(root)\n    try:\n        env = StrictEnvironment(context={\"cookiecutter\": {}})\n        env.loader = FileSystemLoader(\".\")\n        generate_file(str(output), \"mixed.txt\", {\"cookiecutter\": {}}, env)\n    finally:\n        os.chdir(previous)\n    assert (output / \"mixed.txt\").exists()"},{"file":"cookiecutter/generate.py","line":358,"what_goes_wrong":"`skip_if_file_exists=True` is ignored for files matched by `_copy_without_render`, so an existing user-edited file is silently overwritten.","trigger":"Generate a template with `_copy_without_render: [\"literal.txt\"]`, edit the generated `literal.txt`, then generate again with both `overwrite_if_exists=True` and `skip_if_file_exists=True`.","expected":"The existing `literal.txt` should remain unchanged because `skip_if_file_exists` takes priority over overwriting.","actual":"`shutil.copyfile` replaces the user-edited content with the template content.","confidence":"high","verified_by_running":true,"reproduction":"import json\nimport tempfile\nfrom pathlib import Path\nfrom cookiecutter.generate import generate_files\n\nwith tempfile.TemporaryDirectory() as temp:\n    base = Path(temp)\n    repo = base / \"repo\"\n    template = repo / \"{{cookiecutter.name}}\"\n    template.mkdir(parents=True)\n    (repo / \"cookiecutter.json\").write_text(json.dumps({\"name\": \"project\", \"_copy_without_render\": [\"literal.txt\"]}))\n    (template / \"literal.txt\").write_text(\"template content\")\n    context = {\"cookiecutter\": {\"name\": \"project\", \"_copy_without_render\": [\"literal.txt\"]}}\n    output = base / \"output\"\n    generate_files(str(repo), context, output_dir=str(output))\n    produced = output / \"project\" / \"literal.txt\"\n    produced.write_text(\"user edit\")\n    generate_files(str(repo), context, output_dir=str(output), overwrite_if_exists=True, skip_if_file_exists=True)\n    assert produced.read_text() == \"user edit\""}],"what_examined":"Read all production modules, with focused review of generation, prompting, configuration, repository, hook, VCS, and ZIP boundaries; ran Ruff as leads only; attempted the suite (blocked by missing coverage/freezegun dependencies); and directly ran standalone reproducers for the reported generation paths."}
