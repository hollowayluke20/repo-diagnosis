{"findings":[{"file":"cookiecutter/generate.py","line":198,"what_goes_wrong":"Rendered template directory names are normalized but never checked to remain inside `output_dir`. A context value containing `..` therefore writes the generated project outside the caller-selected output directory.","trigger":"A template's top-level directory is rendered from an untrusted or externally supplied value such as `../escape`.","expected":"Generation rejects path-traversing rendered names or confines all output beneath `output_dir`.","actual":"The project is created as a sibling of `output_dir`.","confidence":"high","verified_by_running":true,"reproduction":"import tempfile\nfrom collections import OrderedDict\nfrom pathlib import Path\nfrom cookiecutter.generate import generate_files\n\nbase = Path(tempfile.mkdtemp())\nrepo = base / 'repo'\nrepo.mkdir()\n(repo / 'cookiecutter.json').write_text('{}')\ntemplate = repo / '{{cookiecutter.name}}'\ntemplate.mkdir()\n(template / 'README').write_text('content')\noutput_dir = base / 'output'\nresult = Path(generate_files(\n    str(repo),\n    OrderedDict([('cookiecutter', OrderedDict([('name', '../escape')]))]),\n    str(output_dir),\n    accept_hooks=False,\n))\nassert result.is_relative_to(output_dir)"},{"file":"cookiecutter/find.py","line":25,"what_goes_wrong":"Template discovery treats any matching directory entry as a project template, including regular files. A matching file encountered before the real template directory makes generation fail later.","trigger":"A repository contains a file named with both `cookiecutter` and Jinja delimiters alongside its actual template directory.","expected":"Only child directories should be considered template candidates.","actual":"`find_template()` returns the regular file path.","confidence":"high","verified_by_running":true,"reproduction":"import tempfile\nfrom pathlib import Path\nfrom cookiecutter.find import find_template\n\nrepo = Path(tempfile.mkdtemp())\n(repo / 'cookiecutter{{cookiecutter.name}}.txt').write_text('not a directory')\n(repo / '{{cookiecutter.name}}').mkdir()\nassert Path(find_template(str(repo))).is_dir()"},{"file":"cookiecutter/zipfile.py","line":64,"what_goes_wrong":"ZIP validation assumes the archive's first member must be an explicit directory entry. ZIP archives do not require directory entries, so valid template archives containing only file entries are rejected.","trigger":"Importing a ZIP template whose first entry is `template/cookiecutter.json`, without a preceding `template/` entry.","expected":"The archive is unpacked and its top-level directory is returned.","actual":"`InvalidZipRepository` is raised before extraction.","confidence":"high","verified_by_running":true,"reproduction":"import tempfile\nimport zipfile\nfrom pathlib import Path\nfrom cookiecutter.zipfile import unzip\n\nbase = Path(tempfile.mkdtemp())\narchive = base / 'template.zip'\nwith zipfile.ZipFile(archive, 'w') as zf:\n    zf.writestr('template/cookiecutter.json', '{}')\n    zf.writestr('template/{{cookiecutter.name}}/README', 'content')\nresult = Path(unzip(str(archive), is_url=False))\nassert (result / 'cookiecutter.json').is_file()"},{"file":"cookiecutter/hooks.py","line":108,"what_goes_wrong":"Rendered hook scripts are created with `delete=False` and are never removed after execution. Each generated hook leaves a temporary file behind.","trigger":"Any pre- or post-generation hook runs.","expected":"The temporary rendered hook is removed after `run_script()` completes, including on failures.","actual":"The temporary script remains in the system temp directory.","confidence":"high","verified_by_running":true,"reproduction":"import tempfile\nfrom pathlib import Path\nimport cookiecutter.hooks as hooks\n\nbase = Path(tempfile.mkdtemp())\nscript = base / 'hook.py'\nscript.write_text('')\ncreated = []\nhooks.run_script = lambda path, cwd: created.append(Path(path))\nhooks.run_script_with_context(str(script), str(base), {'cookiecutter': {}})\nassert not created[0].exists(), created[0]"}],"what_examined":"Reviewed the Python package and its tests, and ran focused reproductions with the bundled Python. Full pytest collection was blocked by missing configured coverage support and the `freezegun` test dependency."}
