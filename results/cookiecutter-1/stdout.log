{"findings":[{"file":"cookiecutter/generate.py","line":331,"what_goes_wrong":"A directory marked `_copy_without_render` cannot be regenerated with `overwrite_if_exists=True`, because `copytree` is called without allowing an existing destination.","trigger":"Generate a template containing an `assets/` directory listed in `_copy_without_render`, then generate the same project again with `overwrite_if_exists=True`.","expected":"The existing project's copied directory contents should be overwritten; instead, generation raises `FileExistsError` for the existing `assets` directory.","actual":"`shutil.copytree()` refuses the existing destination directory.","confidence":"high","verified_by_running":true,"reproduction":"import os\nimport tempfile\nfrom cookiecutter.generate import generate_files\n\nwith tempfile.TemporaryDirectory() as root:\n    repo = os.path.join(root, 'repo')\n    template = os.path.join(repo, '{{cookiecutter.name}}')\n    os.makedirs(os.path.join(template, 'assets'))\n    open(os.path.join(repo, 'cookiecutter.json'), 'w').write('{\"name\": \"demo\"}')\n    open(os.path.join(template, 'assets', 'a.txt'), 'w').write('one')\n    context = {'cookiecutter': {'name': 'demo', '_copy_without_render': ['assets']}}\n    generate_files(repo, context, output_dir=root)\n    generate_files(repo, context, output_dir=root, overwrite_if_exists=True)"},{"file":"cookiecutter/generate.py","line":185,"what_goes_wrong":"A text template containing mixed newline styles causes generation to pass a tuple to `open(newline=...)`, which is invalid.","trigger":"Generate a template text file whose content is `one\\r\\ntwo\\n` without setting `_new_lines`.","expected":"Generation should write the rendered text without crashing; instead, it raises `TypeError`.","actual":"`TextIOWrapper.newlines` becomes `('\\n', '\\r\\n')`, and that tuple is passed as `newline`.","confidence":"high","verified_by_running":true,"reproduction":"import os\nimport tempfile\nfrom cookiecutter.generate import generate_files\n\nwith tempfile.TemporaryDirectory() as root:\n    repo = os.path.join(root, 'repo')\n    template = os.path.join(repo, '{{cookiecutter.name}}')\n    os.makedirs(template)\n    open(os.path.join(repo, 'cookiecutter.json'), 'w').write('{\"name\": \"demo\"}')\n    open(os.path.join(template, 'mixed.txt'), 'wb').write(b'one\\r\\ntwo\\n')\n    generate_files(repo, {'cookiecutter': {'name': 'demo'}}, output_dir=root)"},{"file":"cookiecutter/vcs.py","line":32,"what_goes_wrong":"Repository URLs containing a literal `+` are misparsed as explicit VCS prefixes and rejected.","trigger":"Pass the valid Git URL `https://example.invalid/a+b.git` to `identify_repo`.","expected":"The `.git` URL should be identified as Git, as the same URL without `+` is; instead, `UnknownRepoType` is raised.","actual":"Splitting the entire URL on `+` treats `https://example.invalid/a` as a supposed VCS type.","confidence":"high","verified_by_running":true,"reproduction":"from cookiecutter.vcs import identify_repo\n\nassert identify_repo('https://example.invalid/a+b.git') == (\n    'git', 'https://example.invalid/a+b.git'\n)"},{"file":"cookiecutter/find.py","line":22,"what_goes_wrong":"`find_template` accepts a matching file as the project template even though it is required to find a child directory.","trigger":"A repository root contains a file named `cookiecutter{{cookiecutter.name}}.txt` but no templated child directory.","expected":"The file should be ignored and `NonTemplatedInputDirException` raised; instead, its path is returned as the template directory.","actual":"The filename test does not check `os.path.isdir`.","confidence":"high","verified_by_running":true,"reproduction":"import os\nimport tempfile\nfrom cookiecutter.find import find_template\nfrom cookiecutter.exceptions import NonTemplatedInputDirException\n\nwith tempfile.TemporaryDirectory() as repo:\n    open(os.path.join(repo, 'cookiecutter{{cookiecutter.name}}.txt'), 'w').close()\n    try:\n        find_templat