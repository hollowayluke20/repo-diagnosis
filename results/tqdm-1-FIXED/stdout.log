 187: class tqdm(Comparable):
 188:     """
 189:     Decorate an iterable object, returning an iterator which acts exactly
 190:     like the original iterable, but prints a dynamically updating
 191:     progressbar every time a value is requested.
 192:     """
 193: 
 194:     monitor_interval = 10  # set to 0 to disable the thread
 195:     monitor = None
 196: 
 197:     @staticmethod
 198:     def format_sizeof(num, suffix='', divisor=1000):
 199:         """
 200:         Formats a number (greater than unity) with SI Order of Magnitude
 201:         prefixes.
 202: 
 203:         Parameters
 204:         ----------
 205:         num  : float
 206:             Number ( >= 1) to format.
 207:         suffix  : str, optional
 208:             Post-postfix [default: ''].
 209:         divisor  : float, optional
 210:             Divisor between prefixes [default: 1000].
 211: 
 212:         Returns
 213:         -------
 214:         out  : str
 215:             Number with Order of Magnitude SI unit postfix.
 216:         """
 217:         for unit in ['', 'k', 'M', 'G', 'T', 'P', 'E', 'Z']:
 218:             if abs(num) < 999.5:
 219:                 if abs(num) < 99.95:
 220:                     if abs(num) < 9.995:
 221:                         return '{0:1.2f}'.format(num) + unit + suffix
 222:                     return '{0:2.1f}'.format(num) + unit + suffix
 223:                 return '{0:3.0f}'.format(num) + unit + suffix
 224:             num /= divisor
 225:         return '{0:3.1f}Y'.format(num) + suffix
 226: 
 227:     @staticmethod
 228:     def format_interval(t):
 229:         """
 230:         Formats a number of seconds as a clock time, [H:]MM:SS
 231: 
 232:         Parameters
 233:         ----------
 234:         t  : int
 235:             Number of seconds.
 236: 
 237:         Returns
 238:         -------
 239:         out  : str
 240:             [H:]MM:SS
 241:         """
 242:         mins, s = divmod(int(t), 60)
 243:         h, m = divmod(mins, 60)
 244:         if h:
 245:             return '{0:d}:{1:02d}:{2:02d}'.format(h, m, s)
 246:         else:
 247:             return '{0:02d}:{1:02d}'.format(m, s)
 248: 
 249:     @staticmethod
 250:     def format_num(n):
 251:         """
 252:         Intelligent scientific notation (.3g).
 253: 
 254:         Parameters
 255:         ----------
 256:         n  : int or float or Numeric
 257:             A Number.
 258: 
 259:         Returns
 260:         -------
 261:         out  : str
 262:             Formatted number.
 263:         """
 264:         f = '{0:.3g}'.format(n).replace('+0', '+').replace('-0', '-')
 265:         n = str(n)
 266:         return f if len(f) < len(n) else n
 267: 
 268:     @staticmethod
 269:     def ema(x, mu=None, alpha=0.3):
 270:         """
 271:         Exponential moving average: smoothing to give progressively lower
 272:         weights to older values.
 273: 
 274:         Parameters
 275:         ----------
 276:         x  : float
 277:             New value to include in EMA.
 278:         mu  : float, optional
 279:             Previous EMA value.
 280:         alpha  : float, optional
 281:             Smoothing factor in range [0, 1], [default: 0.3].
 282:             Increase to give more weight to recent values.
 283:             Ranges from 0 (yields mu) to 1 (yields x).
 284:         """
 285:         return x if mu is None else (alpha * x) + (1 - alpha) * mu
 286: 
 287:     @staticmethod
 288:     def status_printer(file):
 289:         """
 290:         Manage the printing and in-place updating of a line of characters.
 291:         Note that if the string is longer than a line, then in-place
 292:         updating may not work (it will print a new line at each refresh).
 293:         """
 294:         fp = file
 295:         fp_flush = getattr(fp, 'flush', lambda: None)  # pragma: no cover
 296: 
 297:         def fp_write(s):
 298:             fp.write(_unicode(s))
 299:             fp_flush()
 300: 
 301:         last_len = [0]
 302: 
 303:         def print_status(s):
 304:             len_s = len(s)
 305:             fp_write('\r' + s + (' ' * max(last_len[0] - len_s, 0)))
 306:             last_len[0] = len_s
 307: 
 308:         return print_status
 309: 
 310:     @staticmethod
 311:     def format_meter(n, total, elapsed, ncols=None, prefix='', ascii=False,
 312:                      unit='it', unit_scale=False, rate=None, bar_format=None,
 313:                      postfix=None, unit_divisor=1000, **extra_kwargs):
 314:         """
 315:         Return a string-based progress bar given some parameters
 316: 
 317:         Parameters
 318:         ----------
 319:         n  : int or float
 320:             Number of finished iterations.
 321:         total  : int or float
 322:             The expected total number of iterations. If meaningless (None),
 323:             only basic progress statistics are displayed (no ETA).
 324:         elapsed  : float
 325:             Number of seconds passed since start.
 326:         ncols  : int, optional
 327:             The width of the entire output message. If specified,
 328:             dynamically resizes `{bar}` to stay within this bound
 329:             [default: None]. If `0`, will not print any bar (only stats).
 330:             The fallback is `{bar:10}`.
 331:         prefix  : str, optional
 332:             Prefix message (included in total width) [default: ''].
 333:             Use as {desc} in bar_format string.
 334:         ascii  : bool, optional or str, optional
 335:             If not set, use unicode (smooth blocks) to fill the meter
 336:             [default: False]. The fallback is to use ASCII characters
 337:             " 123456789#".
 338:         unit  : str, optional
 339:             The iteration unit [default: 'it'].
 340:         unit_scale  : bool or int or float, optional
 341:             If 1 or True, the number of iterations will be printed with an
 342:             appropriate SI metric prefix (k = 10^3, M = 10^6, etc.)
 343:             [default: False]. If any other non-zero number, will scale
 344:             `total` and `n`.
 345:         rate  : float, optional
 346:             Manual override for iteration rate.
 347:             If [default: None], uses n/elapsed.
 348:         bar_format  : str, optional
 349:             Specify a custom bar string formatting. May impact performance.
 350:             [default: '{l_bar}{bar}{r_bar}'], where
 351:             l_bar='{desc}: {percentage:3.0f}%|' and
 352:             r_bar='| {n_fmt}/{total_fmt} [{elapsed}<{remaining}, '
 353:               '{rate_fmt}{postfix}]'
 354:             Possible vars: l_bar, bar, r_bar, n, n_fmt, total, total_fmt,
 355:               percentage, elapsed, elapsed_s, ncols, desc, unit,
 356:               rate, rate_fmt, rate_noinv, rate_noinv_fmt,
 357:               rate_inv, rate_inv_fmt, postfix, unit_divisor,
 358:               remaining, remaining_s.
 359:             Note that a trailing ": " is automatically removed after {desc}
 360:             if the latter is empty.
 361:         postfix  : *, optional
 362:             Similar to `prefix`, but placed at the end
 363:             (e.g. for additional stats).
 364:             Note: postfix is usually a string (not a dict) for this method,
 365:             and will if possible be set to postfix = ', ' + postfix.
 366:             However other types are supported (#382).
 367:         unit_divisor  : float, optional
 368:             [default: 1000], ignored unless `unit_scale` is True.
 369: 
 370:         Returns
 371:         -------
 372:         out  : Formatted meter and stats, ready to display.
 373:         """
 374: 
 375:         # sanity check: total
 376:         if total and n >= (total + 0.5):  # allow float imprecision (#849)
 377:             total = None
 378: 
 379:         # apply custom scale if necessary
 380:         if unit_scale and unit_scale not in (True, 1):
 381:             if total:
 382:                 total *= unit_scale
 383:             n *= unit_scale
 384:             if rate:
 385:                 rate *= unit_scale  # by default rate = 1 / self.avg_time
 386:             unit_scale = False
 387: 
 388:         elapsed_str = tqdm.format_interval(elapsed)
 389: 
 390:         # if unspecified, attempt to use rate = average speed
 391:         # (we allow manual override since predicting time is an arcane art)
 392:         if rate is None and elapsed:
 393:             rate = n / elapsed
 394:         inv_rate = 1 / rate if rate else None
 395:         format_sizeof = tqdm.format_sizeof
 396:         rate_noinv_fmt = ((format_sizeof(rate) if unit_scale else
 397:                            '{0:5.2f}'.format(rate))
 398:                           if rate else '?') + unit + '/s'
 399:         rate_inv_fmt = ((format_sizeof(inv_rate) if unit_scale else
 400:                          '{0:5.2f}'.format(inv_rate))
 401:                         if inv_rate else '?') + 's/' + unit
 402:         rate_fmt = rate_inv_fmt if inv_rate and inv_rate > 1 else rate_noinv_fmt
 403: 
 404:         if unit_scale:
 405:             n_fmt = format_sizeof(n, divisor=unit_divisor)
 406:             total_fmt = format_sizeof(total, divisor=unit_divisor) \
 407:                 if total is not None else '?'
 408:         else:
 409:             n_fmt = str(n)
 410:             total_fmt = str(total) if total is not None else '?'
 411: 
 412:         try:
 413:             postfix = ', ' + postfix if postfix else ''
 414:         except TypeError:
 415:             pass
 416: 
 417:         remaining = (total - n) / rate if rate and total else 0
 418:         remaining_str = tqdm.format_interval(remaining) if rate else '?'
 419: 
 420:         # format the stats displayed to the left and right sides of the bar
 421:         if prefix:
 422:             # old prefix setup work around
 423:             bool_prefix_colon_already = (prefix[-2:] == ": ")
 424:             l_bar = prefix if bool_prefix_colon_already else prefix + ": "
 425:         else:
 426:             l_bar = ''
 427: 
 428:         r_bar = '| {0}/{1} [{2}<{3}, {4}{5}]'.format(
 429:             n_fmt, total_fmt, elapsed_str, remaining_str, rate_fmt, postfix)
 430: 
 431:         # Custom bar formatting
 432:         # Populate a dict with all available progress indicators
 433:         format_dict = dict(
 434:             # slight extension of self.format_dict
 435:             n=n, n_fmt=n_fmt, total=total, total_fmt=total_fmt,
 436:             elapsed=elapsed_str, elapsed_s=elapsed,
 437:             ncols=ncols, desc=prefix or '', unit=unit,
 438:             rate=inv_rate if inv_rate and inv_rate > 1 else rate,
 439:             rate_fmt=rate_fmt, rate_noinv=rate,
 440:             rate_noinv_fmt=rate_noinv_fmt, rate_inv=inv_rate,
 441:             rate_inv_fmt=rate_inv_fmt,
 442:             postfix=postfix, unit_divisor=unit_divisor,
 443:             # plus more useful definitions
 444:             remaining=remaining_str, remaining_s=remaining,
 445:             l_bar=l_bar, r_bar=r_bar,
 446:             **extra_kwargs)
 447: 
 448:         # total is known: we can predict some stats
 449:         if total:
 450:             # fractional and percentage progress
 451:             frac = n / total
 452:             percentage = frac * 100
 453: 
 454:             l_bar += '{0:3.0f}%|'.format(percentage)
 455: 
 456:             if ncols == 0:
 457:                 return l_bar[:-1] + r_bar[1:]
 458: 
 459:             format_dict.update(l_bar=l_bar)
 460:             if bar_format:
 461:                 format_dict.update(percentage=percentage)
 462: 
 463:                 # auto-remove colon for empty `desc`
 464:                 if not prefix:
 465:                     bar_format = bar_format.replace("{desc}: ", '')
 466:             else:
 467:                 bar_format = "{l_bar}{bar}{r_bar}"
 468: 
 469:             full_bar = FormatReplace()
 470:             try:
 471:                 nobar = bar_format.format(bar=full_bar, **format_dict)
 472:             except UnicodeEncodeError:
 473:                 bar_format = _unicode(bar_format)
 474:                 nobar = bar_format.format(bar=full_bar, **format_dict)
 475:             if not full_bar.format_called:
 476:                 # no {bar}, we can just format and return
 477:                 return nobar
 478: 
 479:             # Formatting progress bar space available for bar's display
 480:             full_bar = Bar(
 481:                 frac,
 482:                 max(1, ncols - disp_len(nobar))
 483:                 if ncols else 10,
 484:                 charset=Bar.ASCII if ascii is True else ascii or Bar.UTF)
 485:             if not _is_ascii(full_bar.charset) and _is_ascii(bar_format):
 486:                 bar_format = _unicode(bar_format)
 487:             res = bar_format.format(bar=full_bar, **format_dict)
 488:             return disp_trim(res, ncols) if ncols else res
 489: 
 490:         elif bar_format:
 491:             # user-specified bar_format but no total
 492:             l_bar += '|'
 493:             format_dict.update(l_bar=l_bar, percentage=0)
 494:             full_bar = FormatReplace()
 495:             nobar = bar_format.format(bar=full_bar, **format_dict)
 496:             if not full_bar.format_called:
 497:                 return nobar
 498:             full_bar = Bar(
 499:                 0,
 500:                 max(1, ncols - disp_len(nobar))
 501:                 if ncols else 10,
 502:                 charset=Bar.BLANK)
 503:             res = bar_format.format(bar=full_bar, **format_dict)
 504:             return disp_trim(res, ncols) if ncols else res
 505:         else:
 506:             # no total: no progressbar, ETA, just progress stats
 507:             return ((prefix + ": ") if prefix else '') + \
 508:                 '{0}{1} [{2}, {3}{4}]'.format(
 509:                     n_fmt, unit, elapsed_str, rate_fmt, postfix)
 510: 
 511:     def __new__(cls, *args, **kwargs):
 512:         # Create a new instance
 513:         instance = object.__new__(cls)
 514:         # Construct the lock if it does not exist
 515:         with cls.get_lock():
 516:             # Add to the list of instances
 517:             if not hasattr(cls, '_instances'):
 518:                 cls._instances = WeakSet()
 519:             cls._instances.add(instance)
 520:             # Create the monitoring thread
 521:             if cls.monitor_interval and (cls.monitor is None or not
 522:                                          cls.monitor.report()):
 523:                 try:
 524:                     cls.monitor = TMonitor(cls, cls.monitor_interval)
 525:                 except Exception as e:  # pragma: nocover
 526:                     warn("tqdm:disabling monitor support"
 527:                          " (monitor_interval = 0) due to:\n" + str(e),
 528:                          TqdmMonitorWarning, stacklevel=2)
 529:                     cls.monitor_interval = 0
 530:         # Return the instance
 531:         return instance
 532: 
 533:     @classmethod
 534:     def _get_free_pos(cls, instance=None):
 535:         """Skips specified instance."""
 536:         positions = set(abs(inst.pos) for inst in cls._instances
 537:                         if inst is not instance and hasattr(inst, "pos"))
 538:         return min(set(range(len(positions) + 1)).difference(positions))
 539: 
 540:     @classmethod
 541:     def _decr_instances(cls, instance):
 542:         """
 543:         Remove from list and reposition other bars
 544:         so that newer bars won't overlap previous bars
 545:         """
 546:         with cls._lock:
 547:             try:
 548:                 cls._instances.remove(instance)
 549:             except KeyError:
 550:                 # if not instance.gui:  # pragma: no cover
 551:                 #     raise
 552:                 pass  # py2: maybe magically removed already
 553:             # else:
 554:             if not instance.gui:
 555:                 for inst in cls._instances:
 556:                     # negative `pos` means fixed
 557:                     if hasattr(inst, "pos") and inst.pos > abs(instance.pos):
 558:                         inst.clear(nolock=True)
 559:                         inst.pos -= 1
 560:                         # TODO: check this doesn't overwrite another fixed bar
 561:             # Kill monitor if no instances are left
 562:             if not cls._instances and cls.monitor:
 563:                 try:
 564:                     cls.monitor.exit()
 565:                     del cls.monitor
 566:                 except AttributeError:  # pragma: nocover
 567:                     pass
 568:                 else:
 569:                     cls.monitor = None
 570: 
 571:     @classmethod
 572:     def write(cls, s, file=None, end="\n", nolock=False):
 573:         """Print a message via tqdm (without overlap with bars)."""
 574:         fp = file if file is not None else sys.stdout
 575:         with cls.external_write_mode(file=file, nolock=nolock):
 576:             # Write the message
 577:             fp.write(s)
 578:             fp.write(end)
 579: 
 580:     @classmethod
 581:     @contextmanager
 582:     def external_write_mode(cls, file=None, nolock=False):
 583:         """
 584:         Disable tqdm within context and refresh tqdm when exits.
 585:         Useful when writing to standard output stream
 586:         """
 587:         fp = file if file is not None else sys.stdout
 588: 
 589:         if not nolock:
 590:             cls.get_lock().acquire()
 591:         # Clear all bars
 592:         inst_cleared = []
 593:         for inst in getattr(cls, '_instances', []):
 594:             # Clear instance if in the target output file
 595:             # or if write output + tqdm output are both either
 596:             # sys.stdout or sys.stderr (because both are mixed in terminal)
 597:             if hasattr(inst, "start_t") and (inst.fp == fp or all(
 598:                     f in (sys.stdout, sys.stderr) for f in (fp, inst.fp))):
 599:                 inst.clear(nolock=True)
 600:                 inst_cleared.append(inst)
 601:         yield
 602:         # Force refresh display of bars we cleared
 603:         for inst in inst_cleared:
 604:             inst.refresh(nolock=True)
 605:         if not nolock:
 606:             cls._lock.release()
 607: 
 608:     @classmethod
 609:     def set_lock(cls, lock):
 610:         """Set the global lock."""
 611:         cls._lock = lock
 612: 
 613:     @classmethod
 614:     def get_lock(cls):
 615:         """Get the global lock. Construct it if it does not exist."""
 616:         if not hasattr(cls, '_lock'):
 617:             cls._lock = TqdmDefaultWriteLock()
 618:         return cls._lock
