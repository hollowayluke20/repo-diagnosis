{"findings":[{"file":"tqdm/cli.py","line":29,"what_goes_wrong":"CLI string options containing a double quote are rejected because `cast` embeds their value unescaped in an `eval` expression.","trigger":"Run the CLI with `--desc=he\"llo`.","expected":"The description should be the literal string `he\"llo`.","actual":"`tqdm.cli.main` raises `TqdmTypeError`.","confidence":"high","verified_by_running":true,"reproduction":"import sys\nfrom io import StringIO\nfrom tqdm.cli import main\n\nsys.stdin = StringIO('')\nmain(fp=StringIO(), argv=['--desc=he' + chr(34) + 'llo', '--disable=True'])"},{"file":"tqdm/cli.py","line":78,"what_goes_wrong":"`posix_pipe` misses delimiters split across reads when a later delimiter occurs wholly in a subsequent read, undercounting progress.","trigger":"Pipe `a\\r\\nb\\r\\n` using `delim='\\r\\n'` and `buf_size=2`.","expected":"The callback should receive two records, one for each CRLF delimiter.","actual":"The callback receives only one update.","confidence":"high","verified_by_running":true,"reproduction":"from io import StringIO\nfrom tqdm.cli import posix_pipe\n\nupdates = []\nposix_pipe(StringIO('a\\r\\nb\\r\\n'), StringIO(), delim='\\r\\n', buf_size=2,\n           callback=updates.append)\nassert sum(updates) == 2, updates"},{"file":"tqdm/contrib/concurrent.py","line":28,"what_goes_wrong":"`thread_map` and `process_map` require the first iterable to implement `len`, although their documented `map` equivalent accepts generators.","trigger":"Call `thread_map` with a generator as its first iterable.","expected":"It should return the mapped values, with an unknown progress total if necessary.","actual":"It raises `TypeError: object of type 'generator' has no len()`.","confidence":"high","verified_by_running":true,"reproduction":"from tqdm.contrib.concurrent import thread_map\n\nassert thread_map(lambda x: x, (x for x in range(2)), disable=True) == [0, 1]"},{"file":"tqdm/contrib/__init__.py","line":54,"what_goes_wrong":"`tzip` removes `tqdm_class` from its copied options but passes the original options to the selected progress class.","trigger":"Pass `tqdm_class=tqdm` to `tzip` with normal output enabled.","expected":"The selected class should wrap the first iterable and produce `[(1, 2)]`.","actual":"`tqdm` receives an unsupported `tqdm_class` keyword and raises `TqdmKeyError`.","confidence":"high","verified_by_running":true,"reproduction":"from io import StringIO\nfrom tqdm import tqdm\nfrom tqdm.contrib import tzip\n\nassert list(tzip([1], [2], tqdm_class=tqdm, file=StringIO())) == [(1, 2)]"},{"file":"tqdm/tests/tests_tqdm.py","line":126,"what_goes_wrong":"The test setup evaluates the deprecated `setcheckinterval` fallback eagerly even when Python provides `setswitchinterval`.","trigger":"Run the bundled test setup on Python 3.9.","expected":"`pretest()` should configure the available `sys.setswitchinterval` function.","actual":"It raises `AttributeError` because Python 3.9 has no `sys.setcheckinterval`, preventing the test suite from running.","confidence":"high","verified_by_running":true,"reproduction":"from tqdm.tests.tests_tqdm import pretest\n\npretest()"}],"what_examined":"Reviewed the package modules, CLI parsing/pipe paths, contrib wrappers, and test setup; ran ruff as a lead, the bundled nose suite, and focused plain-Python reproductions for each reported defect."}
