 541: @with_setup(pretest, posttest)
 542: def test_max_interval():
 543:     """Test maxinterval"""
 544:     total = 100
 545:     bigstep = 10
 546:     smallstep = 5
 547: 
 548:     # Test without maxinterval
 549:     timer = DiscreteTimer()
 550:     with closing(StringIO()) as our_file:
 551:         with closing(StringIO()) as our_file2:
 552:             # with maxinterval but higher than loop sleep time
 553:             t = tqdm(total=total, file=our_file, miniters=None, mininterval=0,
 554:                      smoothing=1, maxinterval=1e-2)
 555:             cpu_timify(t, timer)
 556: 
 557:             # without maxinterval
 558:             t2 = tqdm(total=total, file=our_file2, miniters=None, mininterval=0,
 559:                       smoothing=1, maxinterval=None)
 560:             cpu_timify(t2, timer)
 561: 
 562:             assert t.dynamic_miniters
 563:             assert t2.dynamic_miniters
 564: 
 565:             # Increase 10 iterations at once
 566:             t.update(bigstep)
 567:             t2.update(bigstep)
 568:             # The next iterations should not trigger maxinterval (step 10)
 569:             for _ in _range(4):
 570:                 t.update(smallstep)
 571:                 t2.update(smallstep)
 572:                 timer.sleep(1e-5)
 573:             t.close()  # because PyPy doesn't gc immediately
 574:             t2.close()  # as above
 575: 
 576:             assert "25%" not in our_file2.getvalue()
 577:         assert "25%" not in our_file.getvalue()
 578: 
 579:     # Test with maxinterval effect
 580:     timer = DiscreteTimer()
 581:     with closing(StringIO()) as our_file:
 582:         with tqdm(total=total, file=our_file, miniters=None, mininterval=0,
 583:                   smoothing=1, maxinterval=1e-4) as t:
 584:             cpu_timify(t, timer)
 585: 
 586:             # Increase 10 iterations at once
 587:             t.update(bigstep)
 588:             # The next iterations should trigger maxinterval (step 5)
 589:             for _ in _range(4):
 590:                 t.update(smallstep)
 591:                 timer.sleep(1e-2)
 592: 
 593:             assert "25%" in our_file.getvalue()
 594: 
 595:     # Test iteration based tqdm with maxinterval effect
 596:     timer = DiscreteTimer()
 597:     with closing(StringIO()) as our_file:
 598:         with tqdm(_range(total), file=our_file, miniters=None,
 599:                   mininterval=1e-5, smoothing=1, maxinterval=1e-4) as t2:
 600:             cpu_timify(t2, timer)
 601: 
 602:             for i in t2:
 603:                 if i >= (bigstep - 1) and \
 604:                    ((i - (bigstep - 1)) % smallstep) == 0:
 605:                     timer.sleep(1e-2)
 606:                 if i >= 3 * bigstep:
 607:                     break
 608: 
 609:         assert "15%" in our_file.getvalue()
 610: 
 611:     # Test different behavior with and without mininterval
 612:     timer = DiscreteTimer()
 613:     total = 1000
 614:     mininterval = 0.1
 615:     maxinterval = 10
 616:     with closing(StringIO()) as our_file:
 617:         with tqdm(total=total, file=our_file, miniters=None, smoothing=1,
 618:                   mininterval=mininterval, maxinterval=maxinterval) as tm1:
 619:             with tqdm(total=total, file=our_file, miniters=None, smoothing=1,
 620:                       mininterval=0, maxinterval=maxinterval) as tm2:
 621: 
 622:                 cpu_timify(tm1, timer)
 623:                 cpu_timify(tm2, timer)
 624: 
 625:                 # Fast iterations, check if dynamic_miniters triggers
 626:                 timer.sleep(mininterval)  # to force update for t1
 627:                 tm1.update(total / 2)
 628:                 tm2.update(total / 2)
 629:                 assert int(tm1.miniters) == tm2.miniters == total / 2
 630: 
 631:                 # Slow iterations, check different miniters if mininterval
 632:                 timer.sleep(maxinterval * 2)
 633:                 tm1.update(total / 2)
 634:                 tm2.update(total / 2)
 635:                 res = [tm1.miniters, tm2.miniters]
 636:                 assert res == [(total / 2) * mininterval / (maxinterval * 2),
 637:                                (total / 2) * maxinterval / (maxinterval * 2)]
 638: 
 639:     # Same with iterable based tqdm
 640:     timer1 = DiscreteTimer()  # need 2 timers for each bar because zip not work
 641:     timer2 = DiscreteTimer()
 642:     total = 100
 643:     mininterval = 0.1
 644:     maxinterval = 10
 645:     with closing(StringIO()) as our_file:
 646:         t1 = tqdm(_range(total), file=our_file, miniters=None, smoothing=1,
 647:                   mininterval=mininterval, maxinterval=maxinterval)
 648:         t2 = tqdm(_range(total), file=our_file, miniters=None, smoothing=1,
 649:                   mininterval=0, maxinterval=maxinterval)
 650: 
 651:         cpu_timify(t1, timer1)
 652:         cpu_timify(t2, timer2)
 653: 
 654:         for i in t1:
 655:             if i == ((total / 2) - 2):
 656:                 timer1.sleep(mininterval)
 657:             if i == (total - 1):
 658:                 timer1.sleep(maxinterval * 2)
 659: 
 660:         for i in t2:
 661:             if i == ((total / 2) - 2):
 662:                 timer2.sleep(mininterval)
 663:             if i == (total - 1):
 664:                 timer2.sleep(maxinterval * 2)
 665: 
 666:         assert t1.miniters == 0.255
 667:         assert t2.miniters == 0.5
 668: 
 669:         t1.close()
 670:         t2.close()
