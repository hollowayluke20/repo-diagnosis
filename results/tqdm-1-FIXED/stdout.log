 688: @with_setup(pretest, posttest)
 689: def test_dynamic_min_iters():
 690:     """Test purely dynamic miniters (and manual updates and __del__)"""
 691:     with closing(StringIO()) as our_file:
 692:         total = 10
 693:         t = tqdm(total=total, file=our_file, miniters=None, mininterval=0,
 694:                  smoothing=1)
 695: 
 696:         t.update()
 697:         # Increase 3 iterations
 698:         t.update(3)
 699:         # The next two iterations should be skipped because of dynamic_miniters
 700:         t.update()
 701:         t.update()
 702:         # The third iteration should be displayed
 703:         t.update()
 704: 
 705:         out = our_file.getvalue()
 706:         assert t.dynamic_miniters
 707:         t.__del__()  # simulate immediate del gc
 708: 
