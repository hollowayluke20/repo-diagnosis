  99: class DiscreteTimer(object):
 100:     """Virtual discrete time manager, to precisely control time for tests"""
 101: 
 102:     def __init__(self):
 103:         self.t = 0.0
 104: 
 105:     def sleep(self, t):
 106:         """Sleep = increment the time counter (almost no CPU used)"""
 107:         self.t += t
 108: 
 109:     def time(self):
 110:         """Get the current time"""
 111:         return self.t
 112: 
 113: 
 114: def cpu_timify(t, timer=None):
 115:     """Force tqdm to use the specified timer instead of system-wide time()"""
 116:     if timer is None:
 117:         timer = DiscreteTimer()
 118:     t._time = timer.time
 119:     t._sleep = timer.sleep
 120:     t.start_t = t.last_print_t = t._time()
 121:     return timer
