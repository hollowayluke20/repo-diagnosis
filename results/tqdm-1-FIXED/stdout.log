 620:     @classmethod
 621:     def pandas(tclass, *targs, **tkwargs):
 622:         """
 623:         Registers the given `tqdm` class with
 624:             pandas.core.
 625:             ( frame.DataFrame
 626:             | series.Series
 627:             | groupby.(generic.)DataFrameGroupBy
 628:             | groupby.(generic.)SeriesGroupBy
 629:             ).progress_apply
 630: 
 631:         A new instance will be create every time `progress_apply` is called,
 632:         and each instance will automatically close() upon completion.
 633: 
 634:         Parameters
 635:         ----------
 636:         targs, tkwargs  : arguments for the tqdm instance
 637: 
 638:         Examples
 639:         --------
 640:         >>> import pandas as pd
 641:         >>> import numpy as np
 642:         >>> from tqdm import tqdm
 643:         >>> from tqdm.gui import tqdm as tqdm_gui
 644:         >>>
 645:         >>> df = pd.DataFrame(np.random.randint(0, 100, (100000, 6)))
 646:         >>> tqdm.pandas(ncols=50)  # can use tqdm_gui, optional kwargs, etc
 647:         >>> # Now you can use `progress_apply` instead of `apply`
 648:         >>> df.groupby(0).progress_apply(lambda x: x**2)
 649: 
 650:         References
 651:         ----------
 652:         https://stackoverflow.com/questions/18603270/
 653:         progress-indicator-during-pandas-operations-python
 654:         """
 655:         from pandas.core.frame import DataFrame
 656:         from pandas.core.series import Series
 657:         try:
 658:             from pandas import Panel
 659:         except ImportError:  # TODO: pandas>0.25.2
 660:             Panel = None
 661:         try:  # pandas>=0.18.0
 662:             from pandas.core.window import _Rolling_and_Expanding
 663:         except ImportError:  # pragma: no cover
 664:             _Rolling_and_Expanding = None
 665:         try:  # pandas>=0.25.0
 666:             from pandas.core.groupby.generic import DataFrameGroupBy, \
 667:                 SeriesGroupBy  # , NDFrameGroupBy
 668:         except ImportError:
 669:             try:  # pandas>=0.23.0
 670:                 from pandas.core.groupby.groupby import DataFrameGroupBy, \
 671:                     SeriesGroupBy
 672:             except ImportError:
 673:                 from pandas.core.groupby import DataFrameGroupBy, \
 674:                     SeriesGroupBy
 675:         try:  # pandas>=0.23.0
 676:             from pandas.core.groupby.groupby import GroupBy
 677:         except ImportError:
 678:             from pandas.core.groupby import GroupBy
 679: 
 680:         try:  # pandas>=0.23.0
 681:             from pandas.core.groupby.groupby import PanelGroupBy
 682:         except ImportError:
 683:             try:
 684:                 from pandas.core.groupby import PanelGroupBy
 685:             except ImportError:  # pandas>=0.25.0
 686:                 PanelGroupBy = None
 687: 
 688:         deprecated_t = [tkwargs.pop('deprecated_t', None)]
 689: 
 690:         def inner_generator(df_function='apply'):
 691:             def inner(df, func, *args, **kwargs):
 692:                 """
 693:                 Parameters
 694:                 ----------
 695:                 df  : (DataFrame|Series)[GroupBy]
 696:                     Data (may be grouped).
 697:                 func  : function
 698:                     To be applied on the (grouped) data.
 699:                 **kwargs  : optional
 700:                     Transmitted to `df.apply()`.
 701:                 """
 702: 
 703:                 # Precompute total iterations
 704:                 total = tkwargs.pop("total", getattr(df, 'ngroups', None))
 705:                 if total is None:  # not grouped
 706:                     if df_function == 'applymap':
 707:                         total = df.size
 708:                     elif isinstance(df, Series):
 709:                         total = len(df)
 710:                     elif _Rolling_and_Expanding is None or \
 711:                             not isinstance(df, _Rolling_and_Expanding):
 712:                         # DataFrame or Panel
 713:                         axis = kwargs.get('axis', 0)
 714:                         if axis == 'index':
 715:                             axis = 0
 716:                         elif axis == 'columns':
 717:                             axis = 1
 718:                         # when axis=0, total is shape[axis1]
 719:                         total = df.size // df.shape[axis]
 720: 
 721:                 # Init bar
 722:                 if deprecated_t[0] is not None:
 723:                     t = deprecated_t[0]
 724:                     deprecated_t[0] = None
 725:                 else:
 726:                     t = tclass(*targs, total=total, **tkwargs)
 727: 
 728:                 if len(args) > 0:
 729:                     # *args intentionally not supported (see #244, #299)
 730:                     TqdmDeprecationWarning(
 731:                         "Except func, normal arguments are intentionally" +
 732:                         " not supported by" +
 733:                         " `(DataFrame|Series|GroupBy).progress_apply`." +
 734:                         " Use keyword arguments instead.",
 735:                         fp_write=getattr(t.fp, 'write', sys.stderr.write))
 736: 
 737:                 try:
 738:                     func = df._is_builtin_func(func)
 739:                 except TypeError:
 740:                     pass
 741: 
 742:                 # Define bar updating wrapper
 743:                 def wrapper(*args, **kwargs):
 744:                     # update tbar correctly
 745:                     # it seems `pandas apply` calls `func` twice
 746:                     # on the first column/row to decide whether it can
 747:                     # take a fast or slow code path; so stop when t.total==t.n
 748:                     t.update(n=1 if not t.total or t.n < t.total else 0)
