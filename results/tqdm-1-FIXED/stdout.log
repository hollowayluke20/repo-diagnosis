 190: def squash_ctrlchars(s):
 191:     """Apply control characters in a string just like a terminal display"""
 192:     # Init variables
 193:     curline = 0  # current line in our fake terminal
 194:     lines = ['']  # state of our fake terminal
 195: 
 196:     # Split input string by control codes
 197:     RE_ctrl = re.compile("(%s)" % ("|".join(CTRLCHR)), flags=re.DOTALL)
 198:     s_split = RE_ctrl.split(s)
 199:     s_split = filter(None, s_split)  # filter out empty splits
 200: 
 201:     # For each control character or message
 202:     for nextctrl in s_split:
 203:         # If it's a control character, apply it
 204:         if nextctrl == '\r':
 205:             # Carriage return
 206:             # Go to the beginning of the line
 207:             # simplified here: we just empty the string
 208:             lines[curline] = ''
 209:         elif nextctrl == '\n':
 210:             # Newline
 211:             # Go to the next line
 212:             if curline < (len(lines) - 1):
 213:                 # If already exists, just move cursor
 214:                 curline += 1
 215:             else:
 216:                 # Else the new line is created
 217:                 lines.append('')
 218:                 curline += 1
 219:         elif nextctrl == '\x1b[A':
 220:             # Move cursor up
 221:             if curline > 0:
 222:                 curline -= 1
 223:             else:
 224:                 raise ValueError("Cannot go up, anymore!")
 225:         # Else, it is a message, we print it on current line
 226:         else:
 227:             lines[curline] += nextctrl
 228: 
 229:     return lines
 230: 
