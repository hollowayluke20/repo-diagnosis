 580:     @classmethod
 581:     @contextmanager
 582:     def external_write_mode(cls, file=None, nolock=False):
 583:         """
 584:         Disable tqdm within context and refresh tqdm when exits.
 585:         Useful when writing to standard output stream
 586:         """
 587:         fp = file if file is not None else sys.stdout
 588: 
 589:         if not nolock:
 590:             cls.get_lock().acquire()
 591:         # Clear all bars
 592:         inst_cleared = []
 593:         for inst in getattr(cls, '_instances', []):
 594:             # Clear instance if in the target output file
 595:             # or if write output + tqdm output are both either
 596:             # sys.stdout or sys.stderr (because both are mixed in terminal)
 597:             if hasattr(inst, "start_t") and (inst.fp == fp or all(
 598:                     f in (sys.stdout, sys.stderr) for f in (fp, inst.fp))):
 599:                 inst.clear(nolock=True)
 600:                 inst_cleared.append(inst)
 601:         yield
 602:         # Force refresh display of bars we cleared
 603:         for inst in inst_cleared:
 604:             inst.refresh(nolock=True)
 605:         if not nolock:
 606:             cls._lock.release()
