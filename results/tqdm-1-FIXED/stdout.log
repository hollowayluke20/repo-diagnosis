1024:         assert res[-1] == '\n'
1025:         if not res.startswith(exres):
1026:             raise AssertionError(
1027:                 "\n<<< Expected:\n{0}\n>>> Got:\n{1}\n===".format(
1028:                     exres + ', ...it/s]\n', our_file.getvalue()))
1029: 
1030:     # Closing after the output stream has closed
1031:     with closing(StringIO()) as our_file:
1032:         t = tqdm(total=2, file=our_file)
1033:         t.update()
1034:         t.update()
1035:     t.close()
