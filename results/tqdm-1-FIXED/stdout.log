 178: def get_bar(all_bars, i):
 179:     """Get a specific update from a whole bar traceback"""
 180:     # Split according to any used control characters
 181:     bars_split = RE_ctrlchr_excl.split(all_bars)
 182:     bars_split = list(filter(None, bars_split))  # filter out empty splits
 183:     return bars_split[i]
 184: 
