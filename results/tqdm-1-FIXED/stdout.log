1652: @with_setup(pretest, posttest)
1653: def test_postfix():
1654:     """Test postfix"""
1655:     postfix = {'float': 0.321034, 'gen': 543, 'str': 'h', 'lst': [2]}
1656:     postfix_order = (('w', 'w'), ('a', 0))  # no need for OrderedDict
1657:     expected = ['float=0.321', 'gen=543', 'lst=[2]', 'str=h']
1658:     expected_order = ['w=w', 'a=0', 'float=0.321', 'gen=543', 'lst=[2]',
1659:                       'str=h']
1660: 
1661:     # Test postfix set at init
1662:     with closing(StringIO()) as our_file:
1663:         with tqdm(total=10, file=our_file, desc='pos0 bar',
1664:                   bar_format='{r_bar}', postfix=postfix) as t1:
1665:             t1.refresh()
1666:             out = our_file.getvalue()
1667: 
1668:     # Test postfix set after init
1669:     with closing(StringIO()) as our_file:
1670:         with trange(10, file=our_file, desc='pos1 bar', bar_format='{r_bar}',
1671:                     postfix=None) as t2:
1672:             t2.set_postfix(**postfix)
1673:             t2.refresh()
1674:             out2 = our_file.getvalue()
1675: 
1676:     # Order of items in dict may change, so need a loop to check per item
1677:     for res in expected:
1678:         assert res in out
1679:         assert res in out2
1680: 
1681:     # Test postfix (with ordered dict and no refresh) set after init
1682:     with closing(StringIO()) as our_file:
1683:         with trange(10, file=our_file, desc='pos2 bar', bar_format='{r_bar}',
1684:                     postfix=None) as t3:
1685:             t3.set_postfix(postfix_order, False, **postfix)
1686:             t3.refresh()  # explicit external refresh
1687:             out3 = our_file.getvalue()
1688: 
1689:     out3 = out3[1:-1].split(', ')[3:]
1690:     assert out3 == expected_order
1691: 
1692:     # Test postfix (with ordered dict and refresh) set after init
1693:     with closing(StringIO()) as our_file:
1694:         with trange(10, file=our_file, desc='pos2 bar',
1695:                     bar_format='{r_bar}', postfix=None) as t4:
1696:             t4.set_postfix(postfix_order, True, **postfix)
1697:             t4.refresh()  # double refresh
1698:             out4 = our_file.getvalue()
1699: 
1700:     assert out4.count('\r') > out3.count('\r')
1701:     assert out4.count(", ".join(expected_order)) == 2
1702: 
1703:     # Test setting postfix string directly
1704:     with closing(StringIO()) as our_file:
1705:         with trange(10, file=our_file, desc='pos2 bar', bar_format='{r_bar}',
1706:                     postfix=None) as t5:
1707:             t5.set_postfix_str("Hello", False)
1708:             t5.set_postfix_str("World")
1709:             out5 = our_file.getvalue()
1710: 
1711:     assert "Hello" not in out5
1712:     out5 = out5[1:-1].split(', ')[3:]
1713:     assert out5 == ["World"]
1714: 
