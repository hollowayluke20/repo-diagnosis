  71: def pos_line_diff(res_list, expected_list, raise_nonempty=True):
  72:     """
  73:     Return differences between two bar output lists.
  74:     To be used with `RE_pos`
  75:     """
  76:     res = [(r, e) for r, e in zip(res_list, expected_list)
  77:            for pos in [len(e) - len(e.lstrip('\n'))]  # bar position
  78:            if r != e  # simple comparison
  79:            if not r.startswith(e)  # start matches
  80:            or not (
  81:                # move up at end (maybe less due to closing bars)
  82:                any(r.endswith(end + i * '\x1b[A') for i in range(pos + 1)
  83:                    for end in [
  84:                        ']',  # bar
  85:                        '  '])  # cleared
  86:                or '100%' in r  # completed bar
  87:                or r == '\n')  # final bar
  88:            or r[(-1 - pos) * len('\x1b[A'):] == '\x1b[A']  # too many moves up
  89:     if raise_nonempty and (res or len(res_list) != len(expected_list)):
  90:         if len(res_list) < len(expected_list):
  91:             res.extend([(None, e) for e in expected_list[len(res_list):]])
  92:         elif len(res_list) > len(expected_list):
  93:             res.extend([(r, None) for r in res_list[len(expected_list):]])
  94:         raise AssertionError(
  95:             "Got => Expected\n" + '\n'.join('%r => %r' % i for i in res))
  96:     return res
