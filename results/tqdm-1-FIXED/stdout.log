1159:     def update(self, n=1):
1160:         """
1161:         Manually update the progress bar, useful for streams
1162:         such as reading files.
1163:         E.g.:
1164:         >>> t = tqdm(total=filesize) # Initialise
1165:         >>> for current_buffer in stream:
1166:         ...    ...
1167:         ...    t.update(len(current_buffer))
1168:         >>> t.close()
1169:         The last line is highly recommended, but possibly not necessary if
1170:         `t.update()` will be called in such a way that `filesize` will be
1171:         exactly reached and printed.
1172: 
1173:         Parameters
1174:         ----------
1175:         n  : int or float, optional
1176:             Increment to add to the internal counter of iterations
1177:             [default: 1]. If using float, consider specifying `{n:.3f}`
1178:             or similar in `bar_format`, or specifying `unit_scale`.
1179:         """
1180:         # N.B.: see __iter__() for more comments.
1181:         if self.disable:
1182:             return
1183: 
1184:         if n < 0:
1185:             self.last_print_n += n  # for auto-refresh logic to work
1186:         self.n += n
1187: 
1188:         # check counter first to reduce calls to time()
1189:         if self.n - self.last_print_n >= self.miniters:
1190:             delta_t = self._time() - self.last_print_t
1191:             if delta_t >= self.mininterval:
1192:                 cur_t = self._time()
1193:                 delta_it = self.n - self.last_print_n  # >= n
1194:                 # elapsed = cur_t - self.start_t
1195:                 # EMA (not just overall average)
1196:                 if self.smoothing and delta_t and delta_it:
1197:                     rate = delta_t / delta_it
1198:                     self.avg_time = self.ema(
1199:                         rate, self.avg_time, self.smoothing)
1200: 
1201:                 if not hasattr(self, "sp"):
1202:                     raise TqdmDeprecationWarning(
1203:                         "Please use `tqdm.gui.tqdm(...)`"
1204:                         " instead of `tqdm(..., gui=True)`\n",
1205:                         fp_write=getattr(self.fp, 'write', sys.stderr.write))
1206: 
1207:                 self.refresh(lock_args=self.lock_args)
1208: 
1209:                 # If no `miniters` was specified, adjust automatically to the
1210:                 # maximum iteration rate seen so far between two prints.
1211:                 # e.g.: After running `tqdm.update(5)`, subsequent
1212:                 # calls to `tqdm.update()` will only cause an update after
1213:                 # at least 5 more iterations.
1214:                 if self.dynamic_miniters:
1215:                     if self.maxinterval and delta_t >= self.maxinterval:
1216:                         if self.mininterval:
1217:                             self.miniters = delta_it * self.mininterval \
1218:                                 / delta_t
1219:                         else:
1220:                             self.miniters = delta_it * self.maxinterval \
1221:                                 / delta_t
1222:                     elif self.smoothing:
1223:                         self.miniters = self.smoothing * delta_it * \
1224:                             (self.mininterval / delta_t
1225:                              if self.mininterval and delta_t
1226:                              else 1) + \
1227:                             (1 - self.smoothing) * self.miniters
1228:                     else:
1229:                         self.miniters = max(self.miniters, delta_it)
1230: 
1231:                 # Store old values for next call
1232:                 self.last_print_n = self.n
1233:                 self.last_print_t = cur_t
1234: 
1235:     def close(self):
1236:         """Cleanup and (if leave=False) close the progressbar."""
1237:         if self.disable:
1238:             return
1239: 
1240:         # Prevent multiple closures
1241:         self.disable = True
1242: 
1243:         # decrement instance pos and remove from internal set
1244:         pos = abs(self.pos)
1245:         self._decr_instances(self)
1246: 
1247:         # GUI mode
1248:         if not hasattr(self, "sp"):
1249:             return
1250: 
1251:         # annoyingly, _supports_unicode isn't good enough
1252:         def fp_write(s):
1253:             self.fp.write(_unicode(s))
1254: 
1255:         try:
1256:             fp_write('')
1257:         except ValueError as e:
1258:             if 'closed' in str(e):
1259:                 return
1260:             raise  # pragma: no cover
1261: 
1262:         leave = pos == 0 if self.leave is None else self.leave
1263: 
1264:         with self._lock:
1265:             if leave:
1266:                 # stats for overall rate (no weighted average)
1267:                 self.avg_time = None
1268:                 self.display(pos=0)
1269:                 fp_write('\n')
1270:             else:
1271:                 self.display(msg='', pos=pos)
1272:                 if not pos:
1273:                     fp_write('\r')
1274: 
1275:     def clear(self, nolock=False):
1276:         """Clear current bar display."""
1277:         if self.disable:
1278:             return
1279: 
1280:         if not nolock:
1281:             self._lock.acquire()
1282:         self.moveto(abs(self.pos))
1283:         self.sp('')
1284:         self.fp.write('\r')  # place cursor back at the beginning of line
1285:         self.moveto(-abs(self.pos))
1286:         if not nolock:
1287:             self._lock.release()
1288: 
1289:     def refresh(self, nolock=False, lock_args=None):
1290:         """
1291:         Force refresh the display of this bar.
1292: 
1293:         Parameters
1294:         ----------
1295:         nolock  : bool, optional
1296:             If `True`, does not lock.
1297:             If [default: `False`]: calls `acquire()` on internal lock.
1298:         lock_args  : tuple, optional
1299:             Passed to internal lock's `acquire()`.
1300:             If specified, will only `display()` if `acquire()` returns `True`.
1301:         """
1302:         if self.disable:
1303:             return
1304: 
1305:         if not nolock:
1306:             if lock_args:
1307:                 if not self._lock.acquire(*lock_args):
1308:                     return False
1309:             else:
1310:                 self._lock.acquire()
1311:         self.display()
1312:         if not nolock:
1313:             self._lock.release()
1314:         return True
1315: 
1316:     def unpause(self):
1317:         """Restart tqdm timer from last print time."""
1318:         cur_t = self._time()
1319:         self.start_t += cur_t - self.last_print_t
