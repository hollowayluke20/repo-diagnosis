 250: def test_format_meter():
 251:     """Test statistics and progress bar formatting"""
 252:     try:
 253:         unich = unichr
 254:     except NameError:
 255:         unich = chr
 256: 
 257:     format_meter = tqdm.format_meter
 258: 
 259:     assert format_meter(0, 1000, 13) == \
 260:         "  0%|          | 0/1000 [00:13<?, ?it/s]"
 261:     # If not implementing any changes to _tqdm.py, set prefix='desc'
 262:     # or else ": : " will be in output, so assertion should change
 263:     assert format_meter(0, 1000, 13, ncols=68, prefix='desc: ') == \
 264:         "desc:   0%|                                | 0/1000 [00:13<?, ?it/s]"
 265:     assert format_meter(231, 1000, 392) == \
 266:         " 23%|" + unich(0x2588) * 2 + unich(0x258e) + \
 267:         "       | 231/1000 [06:32<21:44,  1.70s/it]"
 268:     assert format_meter(10000, 1000, 13) == \
 269:         "10000it [00:13, 769.23it/s]"
 270:     assert format_meter(231, 1000, 392, ncols=56, ascii=True) == \
 271:         " 23%|" + '#' * 3 + '6' + \
 272:         "            | 231/1000 [06:32<21:44,  1.70s/it]"
 273:     assert format_meter(100000, 1000, 13, unit_scale=True, unit='iB') == \
 274:         "100kiB [00:13, 7.69kiB/s]"
 275:     assert format_meter(100, 1000, 12, ncols=0, rate=7.33) == \
 276:         " 10% 100/1000 [00:12<02:02,  7.33it/s]"
 277:     eq_(
 278:         # ncols is small, l_bar is too large
 279:         # l_bar gets chopped
 280:         # no bar
 281:         # no r_bar
 282:         format_meter(
 283:             0, 1000, 13, ncols=10,
 284:             bar_format="************{bar:10}$$$$$$$$$$"),
 285:         "**********"  # 10/12 stars since ncols is 10
 286:     )
 287:     eq_(
 288:         # n_cols allows for l_bar and some of bar
 289:         # l_bar displays
 290:         # bar gets chopped
 291:         # no r_bar
 292:         format_meter(
 293:             0, 1000, 13, ncols=20,
 294:             bar_format="************{bar:10}$$$$$$$$$$"),
 295:         "************        "  # all 12 stars and 8/10 bar parts
 296:     )
 297:     eq_(
 298:         # n_cols allows for l_bar, bar, and some of r_bar
 299:         # l_bar displays
 300:         # bar displays
 301:         # r_bar gets chopped
 302:         format_meter(
 303:             0, 1000, 13, ncols=30,
 304:             bar_format="************{bar:10}$$$$$$$$$$"),
 305:         "************          $$$$$$$$"
 306:         # all 12 stars and 10 bar parts, but only 8/10 dollar signs
 307:     )
 308:     eq_(
 309:         # trim left ANSI; escape is before trim zone
 310:         format_meter(
 311:             0, 1000, 13, ncols=10,
 312:             bar_format="*****\033[22m****\033[0m***{bar:10}$$$$$$$$$$"),
 313:         "*****\033[22m****\033[0m*\033[0m"
 314:         # we only know it has ANSI codes, so we append an END code anyway
 315:     )
 316:     eq_(
 317:         # trim left ANSI; escape is at trim zone
 318:         format_meter(
 319:             0, 1000, 13, ncols=10,
 320:             bar_format="*****\033[22m*****\033[0m**{bar:10}$$$$$$$$$$"),
 321:         "*****\033[22m*****\033[0m"
 322:     )
 323:     eq_(
 324:         # trim left ANSI; escape is after trim zone
 325:         format_meter(
 326:             0, 1000, 13, ncols=10,
 327:             bar_format="*****\033[22m******\033[0m*{bar:10}$$$$$$$$$$"),
 328:         "*****\033[22m*****\033[0m"
 329:     )
 330:     # Check that bar_format correctly adapts {bar} size to the rest
 331:     assert format_meter(20, 100, 12, ncols=13, rate=8.1,
 332:                         bar_format=r'{l_bar}{bar}|{n_fmt}/{total_fmt}') == \
 333:         " 20%|" + unich(0x258f) + "|20/100"
 334:     assert format_meter(20, 100, 12, ncols=14, rate=8.1,
 335:                         bar_format=r'{l_bar}{bar}|{n_fmt}/{total_fmt}') == \
 336:         " 20%|" + unich(0x258d) + " |20/100"
 337:     # Check wide characters
 338:     if sys.version_info >= (3,):
 339:         assert format_meter(0, 1000, 13, ncols=68, prefix='ï½†ï½•ï½Œï½Œï½—ï½‰ï½„ï½”ï½ˆ: ') == \
 340:             "ï½†ï½•ï½Œï½Œï½—ï½‰ï½„ï½”ï½ˆ:   0%|                  | 0/1000 [00:13<?, ?it/s]"
 341:         assert format_meter(0, 1000, 13, ncols=68, prefix='ãƒ‹ãƒƒãƒãƒ³ [ï¾†ï½¯ï¾Žï¾Ÿï¾]: ') == \
 342:             "ãƒ‹ãƒƒãƒãƒ³ [ï¾†ï½¯ï¾Žï¾Ÿï¾]:   0%|                    | 0/1000 [00:13<?, ?it/s]"
 343:     # Check that bar_format can print only {bar} or just one side
 344:     assert format_meter(20, 100, 12, ncols=2, rate=8.1,
 345:                         bar_format=r'{bar}') == \
 346:         unich(0x258d) + " "
 347:     assert format_meter(20, 100, 12, ncols=7, rate=8.1,
 348:                         bar_format=r'{l_bar}{bar}') == \
 349:         " 20%|" + unich(0x258d) + " "
 350:     assert format_meter(20, 100, 12, ncols=6, rate=8.1,
 351:                         bar_format=r'{bar}|test') == \
 352:         unich(0x258f) + "|test"
