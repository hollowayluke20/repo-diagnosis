1012:         with tqdm(total=3, file=our_file, miniters=0, mininterval=0,
1013:                   leave=True) as progressbar:
1014:             assert len(tqdm._instances) == 1
1015:             progressbar.update(3)
1016:             res = our_file.getvalue()
1017:             assert '| 3/3 ' in res  # Should be blank
1018:             assert '\n' not in res
1019:         # close() called
1020:         assert len(tqdm._instances) == 0
1021: 
1022:         exres = res.rsplit(', ', 1)[0]
