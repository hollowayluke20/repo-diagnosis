1735: @contextmanager
1736: def std_out_err_redirect_tqdm(tqdm_file=sys.stderr):
1737:     orig_out_err = sys.stdout, sys.stderr
1738:     try:
1739:         sys.stdout = sys.stderr = DummyTqdmFile(tqdm_file)
1740:         yield orig_out_err[0]
1741:     # Relay exceptions
1742:     except Exception as exc:
1743:         raise exc
1744:     # Always restore sys.stdout/err if necessary
1745:     finally:
1746:         sys.stdout, sys.stderr = orig_out_err
1747: 
