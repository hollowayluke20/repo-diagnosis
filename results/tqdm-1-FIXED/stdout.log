 163:     def write(self, s):
 164:         self.text = self.text[:self.cursor] + s + \
 165:             self.text[self.cursor + len(s):]
 166:         self.cursor += len(s)
 167: 
 168:     def read(self, n=-1):
 169:         _cur = self.cursor
 170:         self.cursor = len(self) if n < 0 \
 171:             else min(_cur + n, len(self))
 172:         return self.text[_cur:self.cursor]
 173: 
 174:     def getvalue(self):
 175:         return self.text
 176: 
