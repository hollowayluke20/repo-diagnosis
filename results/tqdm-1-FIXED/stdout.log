1038: @with_setup(pretest, posttest)
1039: def test_smoothing():
1040:     """Test exponential weighted average smoothing"""
1041:     timer = DiscreteTimer()
1042: 
1043:     # -- Test disabling smoothing
1044:     with closing(StringIO()) as our_file:
1045:         with tqdm(_range(3), file=our_file, smoothing=None, leave=True) as t:
1046:             cpu_timify(t, timer)
1047: 
1048:             for _ in t:
1049:                 pass
1050:         assert '| 3/3 ' in our_file.getvalue()
1051: 
1052:     # -- Test smoothing
1053:     # Compile the regex to find the rate
1054:     # 1st case: no smoothing (only use average)
1055:     with closing(StringIO()) as our_file2:
1056:         with closing(StringIO()) as our_file:
1057:             t = tqdm(_range(3), file=our_file2, smoothing=None, leave=True,
1058:                      miniters=1, mininterval=0)
1059:             cpu_timify(t, timer)
1060: 
1061:             with tqdm(_range(3), file=our_file, smoothing=None, leave=True,
1062:                       miniters=1, mininterval=0) as t2:
1063:                 cpu_timify(t2, timer)
1064: 
1065:                 for i in t2:
1066:                     # Sleep more for first iteration and
1067:                     # see how quickly rate is updated
1068:                     if i == 0:
1069:                         timer.sleep(0.01)
1070:                     else:
1071:                         # Need to sleep in all iterations
1072:                         # to calculate smoothed rate
1073:                         # (else delta_t is 0!)
1074:                         timer.sleep(0.001)
1075:                     t.update()
1076:             n_old = len(tqdm._instances)
1077:             t.close()
1078:             assert len(tqdm._instances) == n_old - 1
1079:             # Get result for iter-based bar
1080:             a = progressbar_rate(get_bar(our_file.getvalue(), 3))
1081:         # Get result for manually updated bar
1082:         a2 = progressbar_rate(get_bar(our_file2.getvalue(), 3))
1083: 
1084:     # 2nd case: use max smoothing (= instant rate)
1085:     with closing(StringIO()) as our_file2:
1086:         with closing(StringIO()) as our_file:
1087:             t = tqdm(_range(3), file=our_file2, smoothing=1, leave=True,
1088:                      miniters=1, mininterval=0)
1089:             cpu_timify(t, timer)
1090: 
1091:             with tqdm(_range(3), file=our_file, smoothing=1, leave=True,
1092:                       miniters=1, mininterval=0) as t2:
1093:                 cpu_timify(t2, timer)
1094: 
1095:                 for i in t2:
1096:                     if i == 0:
1097:                         timer.sleep(0.01)
1098:                     else:
1099:                         timer.sleep(0.001)
1100:                     t.update()
1101:             t.close()
1102:             # Get result for iter-based bar
1103:             b = progressbar_rate(get_bar(our_file.getvalue(), 3))
1104:         # Get result for manually updated bar
1105:         b2 = progressbar_rate(get_bar(our_file2.getvalue(), 3))
1106: 
1107:     # 3rd case: use medium smoothing
1108:     with closing(StringIO()) as our_file2:
1109:         with closing(StringIO()) as our_file:
1110:             t = tqdm(_range(3), file=our_file2, smoothing=0.5, leave=True,
1111:                      miniters=1, mininterval=0)
1112:             cpu_timify(t, timer)
1113: 
1114:             t2 = tqdm(_range(3), file=our_file, smoothing=0.5, leave=True,
1115:                       miniters=1, mininterval=0)
1116:             cpu_timify(t2, timer)
1117: 
1118:             for i in t2:
1119:                 if i == 0:
1120:                     timer.sleep(0.01)
1121:                 else:
1122:                     timer.sleep(0.001)
1123:                 t.update()
1124:             t2.close()
1125:             t.close()
1126:             # Get result for iter-based bar
1127:             c = progressbar_rate(get_bar(our_file.getvalue(), 3))
1128:         # Get result for manually updated bar
1129:         c2 = progressbar_rate(get_bar(our_file2.getvalue(), 3))
1130: 
1131:     # Check that medium smoothing's rate is between no and max smoothing rates
1132:     assert a <= c <= b
1133:     assert a2 <= c2 <= b2
