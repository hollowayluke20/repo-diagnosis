 845: @with_setup(pretest, posttest)
 846: def test_rlock_creation():
 847:     """Test that importing tqdm does not create multiprocessing objects."""
 848:     import multiprocessing as mp
 849:     if sys.version_info < (3, 3):
 850:         # unittest.mock is a 3.3+ feature
 851:         raise SkipTest
 852: 
 853:     # Use 'spawn' instead of 'fork' so that the process does not inherit any
 854:     # globals that have been constructed by running other tests
 855:     ctx = mp.get_context('spawn')
 856:     with ctx.Pool(1) as pool:
 857:         # The pool will propagate the error if the target method fails
 858:         pool.apply(_rlock_creation_target)
 859: 
 860: 
 861: def _rlock_creation_target():
 862:     """Check that the RLock has not been constructed."""
 863:     from unittest.mock import patch
 864:     import multiprocessing as mp
 865: 
 866:     # Patch the RLock class/method but use the original implementation
 867:     with patch('multiprocessing.RLock', wraps=mp.RLock) as rlock_mock:
 868:         # Importing the module should not create a lock
 869:         from tqdm import tqdm
 870:         assert rlock_mock.call_count == 0
 871:         # Creating a progress bar should initialize the lock
 872:         with closing(StringIO()) as our_file:
 873:             with tqdm(file=our_file) as _:  # NOQA
 874:                 pass
 875:         assert rlock_mock.call_count == 1
 876:         # Creating a progress bar again should reuse the lock
 877:         with closing(StringIO()) as our_file:
 878:             with tqdm(file=our_file) as _:  # NOQA
 879:                 pass
 880:         assert rlock_mock.call_count == 1
 881: 
