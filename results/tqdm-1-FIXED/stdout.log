 140:     """
 141:     ASCII = " 123456789#"
 142:     UTF = u" " + u''.join(map(_unich, range(0x258F, 0x2587, -1)))
 143:     BLANK = "  "
 144: 
 145:     def __init__(self, frac, default_len=10, charset=UTF):
 146:         if not (0 <= frac <= 1):
 147:             warn("clamping frac to range [0, 1]", TqdmWarning, stacklevel=2)
 148:             frac = max(0, min(1, frac))
 149:         assert default_len > 0
 150:         self.frac = frac
 151:         self.default_len = default_len
 152:         self.charset = charset
 153: 
 154:     def __format__(self, format_spec):
 155:         if format_spec:
 156:             _type = format_spec[-1].lower()
 157:             try:
 158:                 charset = dict(a=self.ASCII, u=self.UTF, b=self.BLANK)[_type]
 159:             except KeyError:
 160:                 charset = self.charset
 161:             else:
 162:                 format_spec = format_spec[:-1]
 163:             if format_spec:
 164:                 N_BARS = int(format_spec)
 165:                 if N_BARS < 0:
 166:                     N_BARS += self.default_len
 167:             else:
 168:                 N_BARS = self.default_len
 169:         else:
 170:             charset = self.charset
 171:             N_BARS = self.default_len
 172: 
 173:         nsyms = len(charset) - 1
 174:         bar_length, frac_bar_length = divmod(
 175:             int(self.frac * N_BARS * nsyms), nsyms)
 176: 
 177:         bar = charset[-1] * bar_length
 178:         frac_bar = charset[frac_bar_length]
 179: 
 180:         # whitespace padding
 181:         if bar_length < N_BARS:
 182:             return bar + frac_bar + \
 183:                 charset[0] * (N_BARS - bar_length - 1)
 184:         return bar
 185: 
