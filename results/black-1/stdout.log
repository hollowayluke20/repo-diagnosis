`pyproject.toml` should establish the root.","actual":"The lexicographically first sibling's `.git` directory is returned.","confidence":"high","verified_by_running":true,"reproduction":"import tempfile\nfrom pathlib import Path\nimport black\n\nbase = Path(tempfile.mkdtemp())\n(base / \"pyproject.toml\").write_text(\"[tool.black]\\n\")\nleft = base / \"a\"\nright = base / \"b\"\nleft.mkdir()\nright.mkdir()\n(left / \".git\").mkdir()\nfirst = left / \"one.py\"\nsecond = right / \"two.py\"\nfirst.write_text(\"\")\nsecond.write_text(\"\")\n\nassert black.find_project_root((str(first), str(second))) == base\n"},{"file":"black.py","line":5714,"what_goes_wrong":"Directory traversal checks `.gitignore` patterns against absolute paths, so root-anchored ignore rules do not exclude matching files.","trigger":"Run directory discovery in a directory whose `.gitignore` contains `/ignored.py` and which contains `ignored.py`.","expected":"`ignored.py` should be excluded, as the anchored rule matches the file at the project root.","actual":"The file is yielded for formatting because `PathSpec` receives its absolute path.","confidence":"high","verified_by_running":true,"reproduction":"import re\nimport tempfile\nfrom pathlib import Path\nimport black\n\nroot = Path(tempfile.mkdtemp())\n(root / \".gitignore\").write_text(\"/ignored.py\\n\")\nignored = root / \"ignored.py\"\nignored.write_text(\"x=1\\n\")\n\nfound = set(\n    black.gen_python_files_in_dir(\n        root,\n        root,\n        re.compile(r\".*\\.py$\"),\n        re.compile(r\"^$\"),\n        black.Report(),\n        black.get_gitignore(root),\n    )\n)\nassert ignored not in found\n"}],"what_examined":"Inspected the formatter and daemon control flow, configuration/root discovery, directory traversal and ignore matching, parser boundaries, and cache/formatting paths; ran targeted reproductions with the supplied Python and treated Ruff only as a source of leads."}
