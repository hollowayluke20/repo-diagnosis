  877:     ...       target_versions={black.TargetVersion.PY36},
  878:     ...       line_length=10,
  879:     ...       string_normalization=False,
  880:     ...       is_pyi=False,
  881:     ...     ),
  882:     ...   ),
  883:     ... )
