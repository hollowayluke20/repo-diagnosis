 5685: @lru_cache()
 5686: def get_gitignore(root: Path) -> PathSpec:
 5687:     """ Return a PathSpec matching gitignore content if present."""
 5688:     gitignore = root / ".gitignore"
 5689:     lines: List[str] = []
