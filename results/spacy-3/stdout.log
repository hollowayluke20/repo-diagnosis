16: class Lookups(object):
17:     """Container for large lookup tables and dictionaries, e.g. lemmatization
18:     data or tokenizer exception lists. Lookups are available via vocab.lookups,
19:     so they can be accessed before the pipeline components are applied (e.g.
20:     in the tokenizer and lemmatizer), as well as within the pipeline components
21:     via doc.vocab.lookups.
22:     """
23: 
24:     def __init__(self):
25:         """Initialize the Lookups object.
26: 
27:         RETURNS (Lookups): The newly created object.
28: 
29:         DOCS: https://spacy.io/api/lookups#init
30:         """
31:         self._tables = OrderedDict()
32: 
33:     def __contains__(self, name):
34:         """Check if the lookups contain a table of a given name. Delegates to
35:         Lookups.has_table.
36: 
37:         name (unicode): Name of the table.
38:         RETURNS (bool): Whether a table of that name is in the lookups.
39:         """
40:         return self.has_table(name)
41: 
42:     def __len__(self):
43:         """RETURNS (int): The number of tables in the lookups."""
44:         return len(self._tables)
45: 
46:     @property
47:     def tables(self):
48:         """RETURNS (list): Names of all tables in the lookups."""
49:         return list(self._tables.keys())
50: 
51:     def add_table(self, name, data=SimpleFrozenDict()):
52:         """Add a new table to the lookups. Raises an error if the table exists.
53: 
54:         name (unicode): Unique name of table.
55:         data (dict): Optional data to add to the table.
56:         RETURNS (Table): The newly added table.
57: 
58:         DOCS: https://spacy.io/api/lookups#add_table
59:         """
60:         if name in self.tables:
61:             raise ValueError(Errors.E158.format(name=name))
62:         table = Table(name=name, data=data)
63:         self._tables[name] = table
64:         return table
65: 
66:     def get_table(self, name, default=UNSET):
67:         """Get a table. Raises an error if the table doesn't exist and no
68:         default value is provided.
69: 
70:         name (unicode): Name of the table.
71:         default: Optional default value to return if table doesn't exist.
72:         RETURNS (Table): The table.
73: 
74:         DOCS: https://spacy.io/api/lookups#get_table
75:         """
76:         if name not in self._tables:
77:             if default == UNSET:
78:                 raise KeyError(Errors.E159.format(name=name, tables=self.tables))
79:             return default
80:         return self._tables[name]
81: 
82:     def remove_table(self, name):
83:         """Remove a table. Raises an error if the table doesn't exist.
84: 
85:         name (unicode): Name of the table to remove.
86:         RETURNS (Table): The removed table.
87: 
88:         DOCS: https://spacy.io/api/lookups#remove_table
89:         """
90:         if name not in self._tables:
91:             raise KeyError(Errors.E159.format(name=name, tables=self.tables))
92:         return self._tables.pop(name)
93: 
94:     def has_table(self, name):
95:         """Check if the lookups contain a table of a given name.
96: 
97:         name (unicode): Name of the table.
98:         RETURNS (bool): Whether a table of that name exists.
99: 
100:         DOCS: https://spacy.io/api/lookups#has_table
101:         """
102:         return name in self._tables
103: 
104:     def to_bytes(self, **kwargs):
105:         """Serialize the lookups to a bytestring.
106: 
107:         RETURNS (bytes): The serialized Lookups.
108: 
109:         DOCS: https://spacy.io/api/lookups#to_bytes
110:         """
111:         return srsly.msgpack_dumps(self._tables)
112: 
113:     def from_bytes(self, bytes_data, **kwargs):
114:         """Load the lookups from a bytestring.
115: 
116:         bytes_data (bytes): The data to load.
117:         RETURNS (Lookups): The loaded Lookups.
118: 
119:         DOCS: https://spacy.io/api/lookups#from_bytes
120:         """
121:         self._tables = OrderedDict()
122:         for key, value in srsly.msgpack_loads(bytes_data).items():
123:             self._tables[key] = Table(key)
124:             self._tables[key].update(value)
125:         return self
126: 
127:     def to_disk(self, path, **kwargs):
128:         """Save the lookups to a directory as lookups.bin. Expects a path to a
129:         directory, which will be created if it doesn't exist.
130: 
131:         path (unicode / Path): The file path.
132: 
133:         DOCS: https://spacy.io/api/lookups#to_disk
134:         """
135:         if len(self._tables):
136:             path = ensure_path(path)
137:             if not path.exists():
138:                 path.mkdir()
139:             filepath = path / "lookups.bin"
140:             with filepath.open("wb") as file_:
141:                 file_.write(self.to_bytes())
142: 
143:     def from_disk(self, path, **kwargs):
144:         """Load lookups from a directory containing a lookups.bin. Will skip
145:         loading if the file doesn't exist.
146: 
147:         path (unicode / Path): The directory path.
148:         RETURNS (Lookups): The loaded lookups.
149: 
150:         DOCS: https://spacy.io/api/lookups#from_disk
151:         """
152:         path = ensure_path(path)
153:         filepath = path / "lookups.bin"
154:         if filepath.exists():
155:             with filepath.open("rb") as file_:
156:                 data = file_.read()
157:             return self.from_bytes(data)
158:         return self
