154:         """Deserialize the DocBin's annotations from a bytestring.
155: 
156:         bytes_data (bytes): The data to load from.
157:         RETURNS (DocBin): The loaded DocBin.
158: 
159:         DOCS: https://spacy.io/api/docbin#from_bytes
160:         """
161:         msg = srsly.msgpack_loads(zlib.decompress(bytes_data))
162:         self.attrs = msg["attrs"]
163:         self.strings = set(msg["strings"])
164:         lengths = numpy.frombuffer(msg["lengths"], dtype="int32")
165:         flat_spaces = numpy.frombuffer(msg["spaces"], dtype=bool)
166:         flat_tokens = numpy.frombuffer(msg["tokens"], dtype="uint64")
167:         shape = (flat_tokens.size // len(self.attrs), len(self.attrs))
168:         flat_tokens = flat_tokens.reshape(shape)
169:         flat_spaces = flat_spaces.reshape((flat_spaces.size, 1))
170:         self.tokens = NumpyOps().unflatten(flat_tokens, lengths)
171:         self.spaces = NumpyOps().unflatten(flat_spaces, lengths)
172:         self.cats = msg["cats"]
173:         if self.store_user_data and "user_data" in msg:
174:             self.user_data = list(msg["user_data"])
175:         for tokens in self.tokens:
176:             assert len(tokens.shape) == 2, tokens.shape  # this should never happen
177:         return self
178: 
179: 
180: def merge_bins(bins):
181:     merged = None
182:     for byte_string in bins:
183:         if byte_string is not None:
184:             doc_bin = DocBin(store_user_data=True).from_bytes(byte_string)
185:             if merged is None:
186:                 merged = doc_bin
187:             else:
188:                 merged.merge(doc_bin)
189:     if merged is not None:
190:         return merged.to_bytes()
191:     else:
192:         return b""
193: 
194: 
195: def pickle_bin(doc_bin):
196:     return (unpickle_bin, (doc_bin.to_bytes(),))
197: 
198: 
199: def unpickle_bin(byte_string):
200:     return DocBin().from_bytes(byte_string)
201: 
202: 
203: copy_reg.pickle(DocBin, pickle_bin, unpickle_bin)
204: # Compatibility, as we had named it this previously.
205: Binder = DocBin
206: 
207: __all__ = ["DocBin"]
