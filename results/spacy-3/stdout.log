251:         """Serialize table to a bytestring.
252: 
253:         RETURNS (bytes): The serialized table.
254: 
255:         DOCS: https://spacy.io/api/lookups#table.to_bytes
256:         """
257:         data = [
258:             ("name", self.name),
259:             ("dict", dict(self.items())),
