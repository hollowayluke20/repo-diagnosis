571: def itershuffle(iterable, bufsize=1000):
572:     """Shuffle an iterator. This works by holding `bufsize` items back
573:     and yielding them sometime later. Obviously, this is not unbiased â€“
574:     but should be good enough for batching. Larger bufsize means less bias.
575:     From https://gist.github.com/andres-erbsen/1307752
576: 
577:     iterable (iterable): Iterator to shuffle.
578:     bufsize (int): Items to hold back.
579:     YIELDS (iterable): The shuffled iterator.
580:     """
581:     iterable = iter(iterable)
582:     buf = []
583:     try:
584:         while True:
585:             for i in range(random.randint(1, bufsize - len(buf))):
586:                 buf.append(next(iterable))
587:             random.shuffle(buf)
588:             for i in range(random.randint(1, bufsize)):
589:                 if buf:
590:                     yield buf.pop()
591:                 else:
592:                     break
593:     except StopIteration:
594:         random.shuffle(buf)
595:         while buf:
596:             yield buf.pop()
597:         raise StopIteration
