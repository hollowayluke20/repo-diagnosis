874:         # Cycle channels not to break the order of docs.
875:         # The received object is a batch of byte-encoded docs, so flatten them with chain.from_iterable.
876:         byte_docs = chain.from_iterable(recv.recv() for recv in cycle(bytedocs_recv_ch))
