161: class Table(OrderedDict):
162:     """A table in the lookups. Subclass of builtin dict that implements a
163:     slightly more consistent and unified API.
164: 
165:     Includes a Bloom filter to speed up missed lookups.
166:     """
167: 
168:     @classmethod
169:     def from_dict(cls, data, name=None):
170:         """Initialize a new table from a dict.
171: 
172:         data (dict): The dictionary.
173:         name (unicode): Optional table name for reference.
174:         RETURNS (Table): The newly created object.
175: 
176:         DOCS: https://spacy.io/api/lookups#table.from_dict
177:         """
178:         self = cls(name=name)
179:         self.update(data)
180:         return self
181: 
182:     def __init__(self, name=None, data=None):
183:         """Initialize a new table.
184: 
185:         name (unicode): Optional table name for reference.
186:         data (dict): Initial data, used to hint Bloom Filter.
187:         RETURNS (Table): The newly created object.
188: 
189:         DOCS: https://spacy.io/api/lookups#table.init
190:         """
191:         OrderedDict.__init__(self)
192:         self.name = name
193:         # Assume a default size of 1M items
194:         self.default_size = 1e6
195:         size = len(data) if data and len(data) > 0 else self.default_size
196:         self.bloom = BloomFilter.from_error_rate(size)
197:         if data:
198:             self.update(data)
199: 
200:     def __setitem__(self, key, value):
201:         """Set new key/value pair. String keys will be hashed.
202: 
203:         key (unicode / int): The key to set.
204:         value: The value to set.
205:         """
206:         key = get_string_id(key)
207:         OrderedDict.__setitem__(self, key, value)
208:         self.bloom.add(key)
209: 
210:     def set(self, key, value):
211:         """Set new key/value pair. String keys will be hashed.
212:         Same as table[key] = value.
213: 
214:         key (unicode / int): The key to set.
215:         value: The value to set.
216:         """
217:         self[key] = value
218: 
219:     def __getitem__(self, key):
220:         """Get the value for a given key. String keys will be hashed.
221: 
222:         key (unicode / int): The key to get.
223:         RETURNS: The value.
224:         """
225:         key = get_string_id(key)
226:         return OrderedDict.__getitem__(self, key)
227: 
228:     def get(self, key, default=None):
229:         """Get the value for a given key. String keys will be hashed.
230: 
231:         key (unicode / int): The key to get.
232:         default: The default value to return.
233:         RETURNS: The value.
234:         """
235:         key = get_string_id(key)
236:         return OrderedDict.get(self, key, default)
237: 
238:     def __contains__(self, key):
239:         """Check whether a key is in the table. String keys will be hashed.
240: 
241:         key (unicode / int): The key to check.
242:         RETURNS (bool): Whether the key is in the table.
243:         """
244:         key = get_string_id(key)
245:         # This can give a false positive, so we need to check it after
246:         if key not in self.bloom:
247:             return False
248:         return OrderedDict.__contains__(self, key)
249: 
