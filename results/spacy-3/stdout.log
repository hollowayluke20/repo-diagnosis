838:     def _multiprocessing_pipe(self, texts, pipes, n_process, batch_size):
839:         # raw_texts is used later to stop iteration.
840:         texts, raw_texts = itertools.tee(texts)
841:         # for sending texts to worker
842:         texts_q = [mp.Queue() for _ in range(n_process)]
843:         # for receiving byte-encoded docs from worker
844:         bytedocs_recv_ch, bytedocs_send_ch = zip(
845:             *[mp.Pipe(False) for _ in range(n_process)]
846:         )
847: 
848:         batch_texts = minibatch(texts, batch_size)
849:         # Sender sends texts to the workers.
850:         # This is necessary to properly handle infinite length of texts.
851:         # (In this case, all data cannot be sent to the workers at once)
852:         sender = _Sender(batch_texts, texts_q, chunk_size=n_process)
853:         # send twice to make process busy
854:         sender.send()
855:         sender.send()
856: 
857:         procs = [
858:             mp.Process(
859:                 target=_apply_pipes,
860:                 args=(
861:                     self.make_doc,
862:                     pipes,
863:                     rch,
864:                     sch,
865:                     Underscore.get_state(),
