{"findings":[{"file":"tornado/simple_httpclient.py","line":638,"what_goes_wrong":"Following a 302 or 303 redirect clears `body` but leaves `body_producer`, so the redirected GET is still treated as having a request body.","trigger":"A POST request uses `body_producer` and receives a 302 or 303 response while redirects are enabled.","expected":"The follow-up GET has neither a body nor a body producer; actual: it retains the producer and the next request fails Tornado's GET-body validation.","actual":"The copied redirect request retains `body_producer`.","confidence":"high","verified_by_running":true,"reproduction":"from tornado.httpclient import HTTPRequest, _RequestProxy\nfrom tornado.httputil import HTTPHeaders\nfrom tornado.simple_httpclient import _HTTPConnection\n\nclass Client:\n    def fetch(self, request, raise_error=False):\n        assert request.body_producer is None, \"302 redirect must discard the original request body producer\"\n\nrequest = HTTPRequest(\n    \"http://example.test/original\", method=\"POST\", headers={\"Host\": \"example.test\"},\n    body_producer=lambda write: None, follow_redirects=True, max_redirects=1,\n)\nconnection = object.__new__(_HTTPConnection)\nconnection.request = _RequestProxy(request, None)\nconnection.code = 302\nconnection.headers = HTTPHeaders({\"Location\": \"/next\"})\nconnection.chunks = []\nconnection.client = Client()\nconnection.final_callback = lambda response: None\nconnection._remove_timeout = lambda: None\nconnection._release = lambda: None\nconnection.finish()"},{"file":"tornado/locks.py","line":132,"what_goes_wrong":"`Condition.wait` ignores a zero-length `timedelta` deadline and waits indefinitely.","trigger":"Call `Condition().wait(timeout=timedelta(0))` without notifying the condition.","expected":"A zero-duration relative timeout completes immediately with `False`; actual: no timeout is registered and the future remains pending.","actual":"The truthiness check treats `timedelta(0)` as if no timeout were supplied.","confidence":"high","verified_by_running":true,"reproduction":"from datetime import timedelta\nfrom tornado import gen\nfrom tornado.ioloop import IOLoop\nfrom tornado.locks import Condition\n\nwaiter = Condition().wait(timeout=timedelta(0))\nIOLoop.current().run_sync(lambda: gen.sleep(0))\nassert waiter.done() and waiter.result() is False"},{"file":"tornado/locks.py","line":428,"what_goes_wrong":"`Semaphore.acquire` ignores a zero-length `timedelta` deadline and can wait forever on an unavailable semaphore.","trigger":"Call `Semaphore(0).acquire(timeout=timedelta(0))`.","expected":"The acquisition times out immediately; actual: no timeout is registered and its future stays pending.","actual":"The truthiness check treats `timedelta(0)` as no timeout.","confidence":"high","verified_by_running":true,"reproduction":"from datetime import timedelta\nfrom tornado import gen\nfrom tornado.ioloop import IOLoop\nfrom tornado.locks import Semaphore\n\nwaiter = Semaphore(0).acquire(timeout=timedelta(0))\nIOLoop.current().run_sync(lambda: gen.sleep(0))\nassert waiter.done(), \"a zero-duration timeout must complete the acquisition future\""},{"file":"tornado/queues.py","line":62,"what_goes_wrong":"Queue operations ignore a zero-length `timedelta` deadline and leave blocked operations pending.","trigger":"Call `Queue().get(timeout=timedelta(0))` on an empty queue.","expected":"The get future times out immediately; actual: no timeout is scheduled and it remains pending.","actual":"`_set_timeout` uses a truthiness check that discards zero-duration timedeltas.","confidence":"high","verified_by_running":true,"reproduction":"from datetime import timedelta\nfrom tornado import gen\nfrom tornado.ioloop import IOLoop\nfrom tornado.queues import Queue\n\nwaiter = Queue().get(timeout=timedelta(0))\nIOLoop.current().run_sync(lambda: gen.sleep(0))\nassert waiter.done(), \"a zero-duration timeout must complete the get future\""}],"what_examined":"Inspected the Tornado implementation and its tests, ran Ruff as a lead source, ran passing synchronous unit-test groups (escape, HTTP utilities, templates, locales, options, utilities, locks, and queues), and manually exercised redirect and timeout boundary paths with standalone scripts."}
