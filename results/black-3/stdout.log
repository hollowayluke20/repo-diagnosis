  815: 
  816:     newline = "\r\n" if b"\r\n" == lines[0][-2:] else "\n"
  817:     srcbuf.seek(0)
  818:     with io.TextIOWrapper(srcbuf, encoding) as tiow:
  819:         return tiow.read(), encoding, newline
