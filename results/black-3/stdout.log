 3837: def assert_stable(src: str, dst: str, mode: Mode) -> None:
 3838:     """Raise AssertionError if `dst` reformats differently the second time."""
 3839:     newdst = format_str(dst, mode=mode)
 3840:     if dst != newdst:
 3841:         log = dump_to_file(
