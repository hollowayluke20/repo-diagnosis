 3939: def enumerate_reversed(sequence: Sequence[T]) -> Iterator[Tuple[Index, T]]:
 3940:     """Like `reversed(enumerate(sequence))` if that were possible."""
 3941:     index = len(sequence) - 1
 3942:     for element in reversed(sequence):
