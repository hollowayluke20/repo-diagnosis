{"findings":[{"file":"black.py","line":4130,"what_goes_wrong":"An empty or truncated cache file raises EOFError instead of being treated as an invalid cache.","trigger":"The mode-specific cache file exists but contains zero bytes, such as after an interrupted cache write.","expected":"The formatter should ignore the malformed cache and proceed with an empty cache.","actual":"pickle.load raises EOFError, aborting formatting before the cache can be replaced.","confidence":"high","verified_by_running":true,"reproduction":"from pathlib import Path\nfrom tempfile import TemporaryDirectory\nimport black\n\nwith TemporaryDirectory() as directory:\n    black.CACHE_DIR = Path(directory)\n    black.get_cache_file(black.Mode()).touch()\n    assert black.read_cache(black.Mode()) == {}\n"},{"file":"black.py","line":3576,"what_goes_wrong":"`.gitignore` patterns are matched against absolute paths, so root-anchored patterns such as `/ignored.py` do not exclude files under the formatting root.","trigger":"Run recursive formatting in a directory whose `.gitignore` contains `/ignored.py` and which contains `ignored.py`.","expected":"`ignored.py` should be excluded by the root-anchored `.gitignore` rule.","actual":"The generator yields `ignored.py` for formatting.","confidence":"high","verified_by_running":true,"reproduction":"from pathlib import Path\nfrom tempfile import TemporaryDirectory\nimport black\n\nwith TemporaryDirectory() as directory:\n    root = Path(directory)\n    (root / \".gitignore\").write_text(\"/ignored.py\\n\", encoding=\"utf8\")\n    (root / \"ignored.py\").write_text(\"x = 1\\n\", encoding=\"utf8\")\n    (root / \"kept.py\").write_text(\"x = 1\\n\", encoding=\"utf8\")\n    found = set(black.gen_python_files_in_dir(\n        root, root.resolve(),\n        black.re_compile_maybe_verbose(black.DEFAULT_INCLUDES),\n        black.re_compile_maybe_verbose(\"\"), black.Report(), black.get_gitignore(root),\n    ))\n    assert found == {root / \"kept.py\"}\n"},{"file":"black.py","line":3628,"what_goes_wrong":"Project-root selection uses the lexicographically smallest source path rather than the sources’ common parent, allowing one source's configuration to govern an unrelated source.","trigger":"Format files from sibling directories when only the lexically first directory contains `pyproject.toml`.","expected":"Because no project marker is shared by both source paths, the project root should be the filesystem root.","actual":"The function selects the first source's private directory as the project root.","confidence":"high","verified_by_running":true,"reproduction":"from pathlib import Path\nfrom tempfile import TemporaryDirectory\nimport black\n\nwith TemporaryDirectory() as directory:\n    root = Path(directory)\n    (root / \"alpha\").mkdir()\n    (root / \"beta\").mkdir()\n    (root / \"alpha\" / \"pyproject.toml\").write_text(\"[tool.black]\\n\", encoding=\"utf8\")\n    alpha = root / \"alpha\" / \"one.py\"\n    beta = root / \"beta\" / \"two.py\"\n    alpha.touch()\n    beta.touch()\n    assert black.find_project_root((str(alpha), str(beta))) == Path(root.anchor).resolve()\n"},{"file":"blackd.py","line":103,"what_goes_wrong":"The server treats every non-empty `X-Skip-String-Normalization` value, including the literal `false`, as enabled.","trigger":"POST `x = 'abc'\\n` with header `X-Skip-String-Normalization: false`.","expected":"The literal false should leave normalization enabled and return `x = \"abc\"\\n`.","actual":"The server disables normalization and returns 204 because it sees no change.","confidence":"high","verified_by_running":true,"reproduction":"import asyncio\nfrom concurrent.futures import Future\nfrom functools import partial\nfrom aiohttp import ClientSession, web\nimport blackd\n\nclass InlineExecutor:\n    def submit(self, fn, *args, **kwargs):\n        future = Future()\n        try:\n            future.set_result(fn(*args, **kwargs))\n        except BaseException as error:\n            future.set_exception(error)\n        return future\n\nasync def probe():\n    app = web.Application()\n    app.router.add_post(\"/\", partial(blackd.handle, executor=InlineExecutor()))\n    runner = web.AppRunner(app)\n    await runner.setup()\n    site = web.TCPSite(runner, \"127.0.0.1\", 0)\n    await site.start()\n    port = site._server.sockets[0].getsockname()[1]\n    async with ClientSession() as session:\n        response = await session.post(\n            f\"http://127.0.0.1:{port}/\",\n            data=\"x = 'abc'\\n\",\n            headers={\"X-Skip-String-Normalization\": \"false\"},\n        )\n        body = await response.text()\n    await runner.cleanup()\n    assert (response.status, body) == (200, 'x = \"abc\"\\n')\n\nasyncio.run(probe())"}],"what_examined":"Ran the project suite (120 passed, 1 skipped) and Ruff as leads; inspected CLI/config/root discovery, recursive file selection and `.gitignore` handling, cache behavior, decoding/formatting boundaries, and blackd request-header handling. Each reported case was executed as a standalone failing reproduction."}
